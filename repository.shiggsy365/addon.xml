<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.shiggsy365"
       name="shiggsy365 Repository"
       version="1.0.0"
       provider-name="shiggsy365">
    <extension point="xbmc.addon.repository" name="shiggsy365 Repository">
        <dir>
            <info compressed="false">https://shiggsy365.github.io/KodiStremioBridge/addons.xml</info>
            <checksum>https://shiggsy365.github.io/KodiStremioBridge/addons.xml.md5</checksum>
            <datadir zip="true">https://shiggsy365.github.io/KodiStremioBridge/</datadir>
            <hashes>sha256</hashes>
