    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Install and update Stremio Bridge</summary>
        <description lang="en_GB">Kodi repository for shiggsy365's add-ons, including Stremio Bridge. Updates install automatically.</description>
        <platform>all</platform>
