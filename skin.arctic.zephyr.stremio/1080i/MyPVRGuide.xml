<?xml version="1.0" encoding="UTF-8"?>
<!-- Arctic Zephyr Stremio: a full-screen guide. Channel groups as tabs along the top
     with the clock on the right; the focused programme under them; the grid below (a
     slim time ruler, then as many 70px rows as fit: 11, or 13 with "full EPG", which
     hides the programme info).
     No header furniture and no genre colours. -->
<window>
    <menucontrol>9000</menucontrol>
    <background>0</background>
    <defaultcontrol always="true">10</defaultcontrol>
    <views>10</views>
    <controls>
        <include>GlobalBackground</include>
        <control type="group" id="50">
            <control type="group">
                <include>Animation.Common</include>
                <left>20</left>
                <right>20</right>
                <top>10</top>
                <bottom>10</bottom>
                <control type="image">
                    <left>-8</left>
                    <right>-8</right>
                    <top>-8</top>
                    <bottom>-8</bottom>
                    <texture colordiffuse="Panel" border="16">common/rounded-shadow8.png</texture>
                </control>

                <!-- Top bar: channel groups, guide settings, clock -->
                <control type="image">
                    <width>1880</width>
                    <height>70</height>
                    <texture colordiffuse="Black12">common/white.png</texture>
                </control>
                <control type="list" id="11">
                    <left>0</left>
                    <top>3</top>
                    <width>1500</width>
                    <height>64</height>
                    <onup>10</onup>
                    <ondown>10</ondown>
                    <onright>11441</onright>
                    <onleft>11441</onleft>
                    <orientation>horizontal</orientation>
                    <viewtype label="535">list</viewtype>
                    <scrolltime tween="quadratic">400</scrolltime>
                    <itemlayout width="275" height="64">
                        <include>11epglayout</include>
                    </itemlayout>
                    <focusedlayout width="275" height="64">
                        <control type="image">
                            <left>10</left>
                            <top>56</top>
                            <width>200</width>
                            <height>4</height>
                            <texture colordiffuse="$VAR[ColorHighlight]">common/white.png</texture>
                            <visible>Control.HasFocus(11)</visible>
                        </control>
                        <include>11focusepglayout</include>
                    </focusedlayout>
                </control>
                <control type="radiobutton" id="11441">
                    <left>1510</left>
                    <top>-5</top>
                    <font>Button</font>
                    <textcolor>Dark2</textcolor>
                    <width>80</width>
                    <height>80</height>
                    <radioposx>20</radioposx>
                    <radioposy>18</radioposy>
                    <radiowidth>40</radiowidth>
                    <onup>10</onup>
                    <ondown>10</ondown>
                    <onleft>11</onleft>
                    <onclick>SetFocus(9000)</onclick>
                    <onright>SetFocus(11,0,absolute)</onright>
                    <texturenofocus/>
                    <texturefocus/>
                    <textureradioonfocus colordiffuse="$VAR[ColorHighlight]">buttonsdialogs/settings.png</textureradioonfocus>
                    <textureradioonnofocus colordiffuse="PanelWhite70">buttonsdialogs/settings.png</textureradioonnofocus>
                    <textureradioofffocus colordiffuse="$VAR[ColorHighlight]">buttonsdialogs/settings.png</textureradioofffocus>
                    <textureradiooffnofocus colordiffuse="PanelWhite70">buttonsdialogs/settings.png</textureradiooffnofocus>
                </control>
                <control type="label">
                    <right>20</right>
                    <width>300</width>
                    <height>70</height>
                    <align>right</align>
                    <aligny>center</aligny>
                    <font>LargeBold</font>
                    <textcolor>$VAR[ColorHighlight]</textcolor>
                    <label>$INFO[System.Time]</label>
                </control>

                <control type="epggrid" id="10" description="EPG">
                    <left>0</left>
                    <include content="def_top" condition="Skin.HasSetting(pvr.fullepg)">
                        <param name="top" value="72"/>
                    </include>
                    <include content="def_top" condition="!Skin.HasSetting(pvr.fullepg)">
                        <param name="top" value="248"/>
                    </include>
                    <width>1880</width>
                    <include content="def_height" condition="Skin.HasSetting(pvr.fullepg)">
                        <param name="height" value="950"/>
                    </include>
                    <include content="def_height" condition="!Skin.HasSetting(pvr.fullepg)">
                        <param name="height" value="810"/>
                    </include>
                    <include content="def_progresstexture" condition="Skin.HasSetting(pvr.fullepg)">
                        <param name="progresstexture" value="pvr/progressline2.png"/>
                    </include>
                    <include content="def_progresstexture" condition="!Skin.HasSetting(pvr.fullepg)">
                        <param name="progresstexture" value="pvr/progressline.png"/>
                    </include>
                    <onleft>28</onleft>
                    <onup>11</onup>
                    <viewtype label="19069">list</viewtype>
                    <scrolltime tween="quadratic">250</scrolltime>
                    <timeblocks>40</timeblocks>
                    <rulerunit>6</rulerunit>
                    <rulerlayout height="40" width="260">
                        <control type="label" id="2">
                            <posx>10</posx>
                            <posy>4</posy>
                            <width>200</width>
                            <align>left</align>
                            <aligny>top</aligny>
                            <font>EPGTimeline</font>
                            <label>$INFO[ListItem.Label]</label>
                            <textcolor>PanelWhite100</textcolor>
                        </control>
                    </rulerlayout>
                    <channellayout height="70" width="460">
                        <control type="image" id="2">
                            <width>92</width>
                            <height>69</height>
                            <texture border="5">common/white.png</texture>
                            <colordiffuse>Black12</colordiffuse>
                        </control>
                        <control type="image" id="2">
                            <width>138</width>
                            <left>93</left>
                            <height>69</height>
                            <texture border="5">common/white.png</texture>
                            <colordiffuse>Black12</colordiffuse>
                        </control>
                        <control type="image" id="2">
                            <left>232</left>
                            <width>226</width>
                            <height>69</height>
                            <texture border="5">common/white.png</texture>
                            <colordiffuse>Black12</colordiffuse>
                        </control>
                        <control type="image">
                            <width>100%</width>
                            <height>100%</height>
                            <texture>common/selected.png</texture>
                            <aspectratio aligny="top">center</aspectratio>
                            <animation effect="fade" start="100" end="10" condition="true">Conditional</animation>
                            <visible>ListItem.IsPlaying</visible>
                        </control>
                        <control type="label">
                            <posx>253</posx>
                            <width>190</width>
                            <aligny>center</aligny>
                            <height>67</height>
                            <font>ChannelInfo</font>
                            <textcolor>PanelWhite100</textcolor>
                            <label>$INFO[ListItem.ChannelName]</label>
                        </control>
                        <control type="label">
                            <centerleft>45</centerleft>
                            <width>90</width>
                            <align>center</align>
                            <aligny>center</aligny>
                            <height>67</height>
                            <font>ChannelInfo</font>
                            <textcolor>PanelWhite100</textcolor>
                            <label>$INFO[ListItem.ChannelNumberLabel]</label>
                        </control>
                        <control type="image">
                            <top>2</top>
                            <bottom>2</bottom>
                            <right>247</right>
                            <width>100</width>
                            <texture>$INFO[ListItem.Icon]</texture>
                            <aspectratio aligny="center" align="center">keep</aspectratio>
                        </control>
                    </channellayout>
                    <focusedchannellayout height="70" width="460">
                        <control type="image" id="2">
                            <width>92</width>
                            <height>69</height>
                            <texture border="5">common/white.png</texture>
                            <colordiffuse>Black12</colordiffuse>
                        </control>
                        <control type="image" id="2">
                            <width>138</width>
                            <left>93</left>
                            <height>69</height>
                            <texture border="5">common/white.png</texture>
                            <colordiffuse>Black12</colordiffuse>
                        </control>
                        <control type="image" id="2">
                            <left>232</left>
                            <width>226</width>
                            <height>69</height>
                            <texture border="5">common/white.png</texture>
                            <colordiffuse>Black12</colordiffuse>
                        </control>
                        <control type="image">
                            <width>100%</width>
                            <height>69</height>
                            <texture colordiffuse="$VAR[ColorSelectOtherBar]">common/white.png</texture>
                            <visible>Control.HasFocus(10)</visible>
                        </control>
                        <control type="image">
                            <width>100%</width>
                            <height>69</height>
                            <texture border="5" colordiffuse="$VAR[ColorHighlightOtherBar]">common/gradient-box-wide.png</texture>
                            <visible>Control.HasFocus(10)</visible>
                        </control>
                        <control type="image">
                            <width>100%</width>
                            <height>100%</height>
                            <texture>common/selected.png</texture>
                            <aspectratio aligny="top">center</aspectratio>
                            <animation effect="fade" start="100" end="10" condition="true">Conditional</animation>
                            <visible>ListItem.IsPlaying</visible>
                        </control>
                        <control type="label">
                            <posx>253</posx>
                            <width>190</width>
                            <aligny>center</aligny>
                            <height>67</height>
                            <font>ChannelInfo</font>
                            <textcolor>Selected</textcolor>
                            <label>$INFO[ListItem.ChannelName]</label>
                        </control>
                        <control type="label">
                            <centerleft>45</centerleft>
                            <width>90</width>
                            <align>center</align>
                            <aligny>center</aligny>
                            <height>67</height>
                            <font>ChannelInfo</font>
                            <textcolor>Selected</textcolor>
                            <label>$INFO[ListItem.ChannelNumberLabel]</label>
                        </control>
                        <control type="image">
                            <top>2</top>
                            <bottom>2</bottom>
                            <right>247</right>
                            <width>100</width>
                            <texture>$INFO[ListItem.Icon]</texture>
                            <aspectratio aligny="center" align="center">keep</aspectratio>
                        </control>
                    </focusedchannellayout>
                    <itemlayout height="70" width="260">
                        <control type="image" id="2">
                            <width>259</width>
                            <height>69</height>
                            <texture border="5">common/white.png</texture>
                            <colordiffuse>Black12</colordiffuse>
                        </control>
                        <control type="image">
                            <posy>6</posy>
                            <width>52</width>
                            <height>52</height>
                            <texture>special://skin/extras/icons/timer.png</texture>
                            <colordiffuse>PanelWhite70</colordiffuse>
                            <visible>ListItem.HasTimer | ListItem.IsRecording</visible>
                        </control>
                        <control type="label" id="1">
                            <posx>0</posx>
                            <height>66</height>
                            <width>285</width>
                            <textoffsetx>50</textoffsetx>
                            <textcolor>PanelWhite70</textcolor>
                            <label>$INFO[ListItem.Label]</label>
                            <visible>ListItem.HasTimer | ListItem.IsRecording</visible>
                        </control>
                        <control type="label" id="1">
                            <posx>12</posx>
                            <top>0</top>
                            <width>226</width>
                            <height>67</height>
                            <font>ChannelInfo</font>
                            <textcolor>PanelWhite70</textcolor>
                            <textoffsetx>0</textoffsetx>
                            <label>$INFO[ListItem.Label]</label>
                            <visible>!ListItem.HasTimer + !ListItem.IsRecording</visible>
                        </control>
                    </itemlayout>
                    <focusedlayout height="70" width="260">
                        <control type="image" id="2">
                            <width>259</width>
                            <height>69</height>
                            <texture border="5">common/white.png</texture>
                            <visible>!Control.HasFocus(10)</visible>
                            <colordiffuse>Black12</colordiffuse>
                        </control>
                        <control type="image" id="2">
                            <width>258</width>
                            <height>69</height>
                            <visible>Control.HasFocus(10)</visible>
                            <texture border="5">common/white.png</texture>
                        </control>
                        <control type="image" id="2">
                            <width>256</width>
                            <height>67</height>
                            <left>1</left>
                            <top>1</top>
                            <visible>Control.HasFocus(10)</visible>
                            <texture colordiffuse="$VAR[ColorSelectOtherBar]">common/white.png</texture>
                            <colordiffuse>$VAR[ColorHighlight]</colordiffuse>
                        </control>
                        <control type="image" id="2">
                            <width>256</width>
                            <height>67</height>
                            <left>1</left>
                            <top>1</top>
                            <visible>Control.HasFocus(10)</visible>
                            <texture border="8" colordiffuse="$VAR[ColorHighlightOtherBar]">common/gradient-box-wide.png</texture>
                            <colordiffuse>$VAR[ColorHighlight]</colordiffuse>
                        </control>
                        <control type="image">
                            <width>256</width>
                            <height>67</height>
                            <left>1</left>
                            <top>1</top>
                            <texture>common/selected.png</texture>
                            <aspectratio aligny="top">center</aspectratio>
                            <animation effect="fade" start="100" end="100" condition="true">Conditional</animation>
                            <visible>ListItem.IsPlaying</visible>
                        </control>
                        <control type="image">
                            <posy>6</posy>
                            <width>52</width>
                            <height>52</height>
                            <texture>special://skin/extras/icons/timer.png</texture>
                            <colordiffuse>Selected</colordiffuse>
                            <visible>ListItem.HasTimer | ListItem.IsRecording</visible>
                        </control>
                        <control type="label" id="1">
                            <posx>0</posx>
                            <height>66</height>
                            <width>285</width>
                            <textoffsetx>50</textoffsetx>
                            <textcolor>Selected</textcolor>
                            <label>$INFO[ListItem.Label]</label>
                            <visible>ListItem.HasTimer | ListItem.IsRecording</visible>
                        </control>
                        <control type="label" id="1">
                            <posx>12</posx>
                            <top>0</top>
                            <width>226</width>
                            <height>67</height>
                            <font>ChannelInfo</font>
                            <textcolor>Selected</textcolor>
                            <textoffsetx>0</textoffsetx>
                            <label>$INFO[ListItem.Label]</label>
                            <visible>!ListItem.HasTimer + !ListItem.IsRecording</visible>
                        </control>
                    </focusedlayout>
                </control>

                <!-- The focused programme: under the tab bar, above the grid -->
                <control type="group">
                    <top>78</top>
                    <height>164</height>
                    <left>30</left>
                    <right>20</right>
                    <visible>!Skin.HasSetting(pvr.fullepg)</visible>
                    <control type="label">
                        <top>4</top>
                        <right>280</right>
                        <height>60</height>
                        <aligny>center</aligny>
                        <font>Large</font>
                        <textcolor>PanelWhite100</textcolor>
                        <label>$INFO[ListItem.Title]</label>
                    </control>
                    <control type="label">
                        <top>4</top>
                        <right>270</right>
                        <width>600</width>
                        <height>60</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>Large</font>
                        <textcolor>PanelWhite100</textcolor>
                        <label>$INFO[ListItem.StartTime]$INFO[ListItem.EndTime, - ,]</label>
                    </control>
                    <control type="textbox">
                        <top>68</top>
                        <right>270</right>
                        <height>90</height>
                        <align>justify</align>
                        <font>Small</font>
                        <textcolor>PanelWhite70</textcolor>
                        <label>$INFO[ListItem.Plot]</label>
                    </control>
                    <control type="image">
                        <right>0</right>
                        <top>8</top>
                        <width>250</width>
                        <height>150</height>
                        <aspectratio align="center" aligny="center">keep</aspectratio>
                        <texture>$VAR[ChannelListEPGIconVar]</texture>
                        <fadetime>PosterFanartFadetime</fadetime>
                    </control>
                </control>
            </control>
        </control>
        <include>PVRSideBlade</include>
    </controls>
</window>
