<?xml version="1.0" encoding="UTF-8"?>
<!-- Foundation -->
<window id="2003">
    <defaultcontrol always="true">9610</defaultcontrol>
    <!-- Arctic Zephyr Stremio: freeze the page's Stremio Bridge properties. Inside this
         dialog ListItem.* follows whichever list has focus (cast, similar, the show
         browser), so the buttons and the show browser read these instead. -->
    <onload>SetProperty(sbinfo.id,$INFO[ListItem.Property(stremiobridge.id)],home)</onload>
    <onload>SetProperty(sbinfo.type,$INFO[ListItem.Property(stremiobridge.type)],home)</onload>
    <onload>SetProperty(sbinfo.video,$INFO[ListItem.Property(stremiobridge.video)],home)</onload>
    <onload>SetProperty(sbinfo.season,$INFO[ListItem.Property(stremiobridge.season)],home)</onload>
    <onload>SetProperty(sbinfo.play_action,$INFO[ListItem.Property(stremiobridge.play_action)],home)</onload>
    <onload>SetProperty(sbinfo.streams_action,$INFO[ListItem.Property(stremiobridge.streams_action)],home)</onload>
    <onload>SetProperty(sbinfo.watched_action,$INFO[ListItem.Property(stremiobridge.watched_action)],home)</onload>
    <onload>SetProperty(sbinfo.watchlist_action,$INFO[ListItem.Property(stremiobridge.watchlist_action)],home)</onload>
    <onload>SetProperty(sbinfo.watchlist,$INFO[ListItem.Property(stremiobridge.watchlist)],home)</onload>
    <onload>SetProperty(sbinfo.browse,$INFO[ListItem.Property(stremiobridge.browse)],home)</onload>
    <onload>SetProperty(sbinfo.similar,$INFO[ListItem.Property(stremiobridge.similar)],home)</onload>
    <onload>SetProperty(sbinfo.focus_video,$INFO[ListItem.Property(stremiobridge.focus_video)],home)</onload>
    <onload>SetProperty(sbinfo.default_season,$INFO[ListItem.Property(stremiobridge.default_season)],home)</onload>
    <onload>SetProperty(sbinfo.season_focus,$INFO[ListItem.Property(stremiobridge.default_season)],home)</onload>
    <onload>ClearProperty(sbinfo.browser_rev,home)</onload>
    <onload>SetProperty(sbinfo.trailer,$INFO[ListItem.Trailer],home)</onload>
    <onload>SetProperty(sbinfo.play_label,$ESCINFO[ListItem.Property(stremiobridge.play_label)],home)</onload>
    <onload>SetProperty(sbinfo.facts,$ESCINFO[ListItem.Property(stremiobridge.facts)],home)</onload>
    <onload>SetProperty(sbinfo.genres,$ESCINFO[ListItem.Property(stremiobridge.genres)],home)</onload>
    <onload>SetProperty(sbinfo.certification,$ESCINFO[ListItem.Property(stremiobridge.certification)],home)</onload>
    <onload>SetProperty(sbinfo.rating,$ESCINFO[ListItem.Property(stremiobridge.rating)],home)</onload>
    <onload>SetProperty(sbinfo.title,$ESCINFO[ListItem.Property(stremiobridge.title)],home)</onload>
    <onload>SetProperty(sbinfo.subtitle,$ESCINFO[ListItem.Property(stremiobridge.subtitle)],home)</onload>
    <onload>SetProperty(sbinfo.plot,$ESCINFO[ListItem.Plot],home)</onload>
    <!-- a changed label restarts the plot's scrolling from the top (the textbox keeps its
         place between pages otherwise) -->
    <onload>SetProperty(sbinfo.plotreset," ",home)</onload>
    <onload>AlarmClock(sbinfoplotreset,ClearProperty(sbinfo.plotreset,home),00:01,silent)</onload>
    <onload>SetProperty(sbinfo.fanart,$INFO[ListItem.Art(fanart)],home)</onload>
    <onload>SetProperty(sbinfo.clearlogo,$INFO[ListItem.Art(tvshow.clearlogo)],home)</onload>
    <onload condition="!String.IsEmpty(ListItem.Art(clearlogo))">SetProperty(sbinfo.clearlogo,$INFO[ListItem.Art(clearlogo)],home)</onload>
    <onload>ClearProperty(sbinfo.watched,home)</onload>
    <onload>ClearProperty(sbinfo.resumable,home)</onload>
    <onload condition="Integer.IsGreater(ListItem.PlayCount,0)">SetProperty(sbinfo.watched,1,home)</onload>
    <onload condition="ListItem.IsResumable">SetProperty(sbinfo.resumable,1,home)</onload>
    <onload condition="!$EXP[SBInfoPage] + ListItem.IsResumable">SetFocus(9)</onload>
    <onload condition="!$EXP[SBInfoPage] + !ListItem.IsResumable">SetFocus(8)</onload>
    <!-- Stremio Bridge titles: the new page (Includes_StremioInfo.xml) opens on Play -->
    <onload condition="$EXP[SBInfoPage]">SetFocus(9610)</onload>
    <zorder>0</zorder>
    <onunload>ClearProperty(sbinfo.id,home)</onunload>
    <onunload>ClearProperty(sbinfo.type,home)</onunload>
    <onunload>ClearProperty(sbinfo.video,home)</onunload>
    <onunload>ClearProperty(sbinfo.season,home)</onunload>
    <onunload>ClearProperty(sbinfo.play_action,home)</onunload>
    <onunload>ClearProperty(sbinfo.streams_action,home)</onunload>
    <onunload>ClearProperty(sbinfo.watched_action,home)</onunload>
    <onunload>ClearProperty(sbinfo.watchlist_action,home)</onunload>
    <onunload>ClearProperty(sbinfo.watchlist,home)</onunload>
    <onunload>ClearProperty(sbinfo.browse,home)</onunload>
    <onunload>ClearProperty(sbinfo.similar,home)</onunload>
    <onunload>ClearProperty(sbinfo.focus_video,home)</onunload>
    <onunload>ClearProperty(sbinfo.default_season,home)</onunload>
    <onunload>ClearProperty(sbinfo.season_focus,home)</onunload>
    <onunload>ClearProperty(sbinfo.browser_rev,home)</onunload>
    <onunload>ClearProperty(sbinfo.trailer,home)</onunload>
    <onunload>ClearProperty(sbinfo.fanart,home)</onunload>
    <onunload>ClearProperty(sbinfo.clearlogo,home)</onunload>
    <onunload>ClearProperty(sbinfo.watched,home)</onunload>
    <onunload>ClearProperty(sbinfo.resumable,home)</onunload>
    <onunload>ClearProperty(sbinfo.play_label,home)</onunload>
    <onunload>ClearProperty(sbinfo.facts,home)</onunload>
    <onunload>ClearProperty(sbinfo.genres,home)</onunload>
    <onunload>ClearProperty(sbinfo.certification,home)</onunload>
    <onunload>ClearProperty(sbinfo.rating,home)</onunload>
    <onunload>ClearProperty(sbinfo.title,home)</onunload>
    <onunload>ClearProperty(sbinfo.subtitle,home)</onunload>
    <onunload>ClearProperty(sbinfo.plot,home)</onunload>
    <onunload condition="!String.IsEmpty(Window(home).Property(shownowplayinginfo))">SetFocus(4000)</onunload>
    <onunload condition="!String.IsEmpty(Window(home).Property(shownowplayinginfo))">ClearProperty(shownowplayinginfo,home)</onunload>
    <onload condition="Skin.HasSetting(home.netflix.autoplay.trailer) + Skin.HasSetting(trailer.stop.on.dialogvideoinfo) + $EXP[TrailerIsPlaying] + Player.Playing">Stop</onload>
    <onload condition="Skin.HasSetting(home.netflix.autoplay.trailer) + Skin.HasSetting(trailer.pause.on.dialogvideoinfo) + $EXP[TrailerIsPlaying] + Player.Playing">Pause</onload>
    <onunload condition="Skin.HasSetting(home.netflix.autoplay.trailer) + Skin.HasSetting(trailer.pause.on.dialogvideoinfo) + $EXP[TrailerIsPlaying] + Player.Paused">Pause</onunload>
    <controls>
        <!-- Arctic Zephyr Stremio: the page's own background. Otherwise it's the window
             behind's, drawn from that window's focused item: right from a library list,
             but from the search page that's a search result, often without fanart. -->
        <control type="group">
            <visible>$EXP[SBInfoPage] + !String.IsEmpty(Window(home).Property(sbinfo.fanart)) + !Skin.HasSetting(global.hidefanart)</visible>
            <visible>![Player.HasVideo + Skin.HasSetting(global.showvideo)]</visible>
            <include>Animation.Background.OpenClose</include>
            <control type="image">
                <include>Dimensions_Fullscreen</include>
                <texture colordiffuse="Background">common/bg.jpg</texture>
            </control>
            <control type="image">
                <include>Dimensions_Fullscreen</include>
                <include>GlobalBackgroundFade</include>
                <aspectratio>scale</aspectratio>
                <fadetime>BackgroundFanartFadetime</fadetime>
                <texture background="true">$INFO[Window(home).Property(sbinfo.fanart)]</texture>
            </control>
        </control>
        <!-- Library titles and other add-ons' items: a small page in the same style -->
        <include>SBInfoFallbackPage</include>
        <include>StremioInfoPage</include>
    </controls>
</window>
