    <include name="StremioHiddenCastList">
        <control type="list" id="50">
            <left>-3000</left>
            <top>0</top>
            <width>10</width>
            <height>10</height>
            <visible>false</visible>
            <itemlayout width="10" height="10"/>
            <focusedlayout width="10" height="10"/>
        </control>
    </include>

    <variable name="StremioReleaseDate">
        <value condition="!String.IsEmpty(ListItem.Property(ReleaseDate))">$INFO[ListItem.Property(ReleaseDate)]</value>
        <value>$INFO[ListItem.Year]</value>
    </variable>

    <!-- Season names in the show browser: a fully watched season is dimmer (and struck through) -->
    <variable name="StremioSeasonColor">
        <value condition="String.IsEqual(ListItem.Overlay,OverlayWatched.png)">Dark3</value>
        <value>Dark2</value>
    </variable>

    <!-- The info page's season tabs and episodes (Includes_StremioInfo.xml): empty until
         DialogVideoInfo.xml's onload has frozen the page's title (sbinfo.*), so they don't
         load once with no title. `focus` is what the plugin selects once the list shows: the
         page's season (or the one marked watched from it) and its episode, or the next to
         watch. `rev` changes to reload both in place (Stremio Bridge's info_mark).
         Until the season tabs have loaded and moved to that season (the plugin then sets
         sbinfo.seasons_ready), the episodes are the page's season's: following the tabs
         straight away loaded season 1 first, then the right season again. -->
    <variable name="StremioInfoSeasonsPath">
        <value condition="!String.IsEmpty(Window(home).Property(sbinfo.id)) + !String.IsEmpty(Window(home).Property(sbinfo.browse))">plugin://plugin.video.stremiobridge/?action=info_seasons&amp;type=$INFO[Window(home).Property(sbinfo.type)]&amp;id=$INFO[Window(home).Property(sbinfo.id)]&amp;focus=$INFO[Window(home).Property(sbinfo.season_focus)]&amp;rev=$INFO[Window(home).Property(sbinfo.browser_rev)]</value>
    </variable>
    <variable name="StremioInfoEpisodesPath">
        <value condition="!String.IsEmpty(Window(home).Property(sbinfo.id)) + !String.IsEmpty(Window(home).Property(sbinfo.browse)) + String.IsEmpty(Window(home).Property(sbinfo.seasons_ready))">plugin://plugin.video.stremiobridge/?action=info_episodes&amp;type=$INFO[Window(home).Property(sbinfo.type)]&amp;id=$INFO[Window(home).Property(sbinfo.id)]&amp;season=$INFO[Window(home).Property(sbinfo.season_focus)]&amp;focus=$INFO[Window(home).Property(sbinfo.focus_video)]&amp;rev=$INFO[Window(home).Property(sbinfo.browser_rev)]</value>
        <value condition="!String.IsEmpty(Window(home).Property(sbinfo.id)) + !String.IsEmpty(Window(home).Property(sbinfo.browse))">plugin://plugin.video.stremiobridge/?action=info_episodes&amp;type=$INFO[Window(home).Property(sbinfo.type)]&amp;id=$INFO[Window(home).Property(sbinfo.id)]&amp;season=$INFO[Container(5060).ListItem.Property(season)]&amp;focus=$INFO[Window(home).Property(sbinfo.focus_video)]&amp;rev=$INFO[Window(home).Property(sbinfo.browser_rev)]</value>
    </variable>

    <!-- The search page (Custom_1170_Search.xml) -->
    <variable name="SBSearchOnPill301">
        <value condition="Control.HasFocus(301)">FF101010</value>
        <value>Dark1</value>
    </variable>
    <variable name="SBSearchOnPill302">
        <value condition="Control.HasFocus(302)">FF101010</value>
        <value>Dark1</value>
    </variable>
    <variable name="StremioSearchListPath">
        <value condition="String.IsEmpty(Window(home).Property(sbsearch.query))">plugin://plugin.video.stremiobridge/?action=search_recent&amp;q=$INFO[Window(home).Property(sbsearch.rev)]</value>
        <value>plugin://plugin.video.stremiobridge/?action=search_suggest&amp;q=$INFO[Window(home).Property(sbsearch.query)]&amp;n=$INFO[Container(401).NumItems]-$INFO[Container(402).NumItems]-$INFO[Window(home).Property(sbsearch.rev)]</value>
    </variable>
    <variable name="StremioSearchKeysToggleLabel">
        <value condition="String.IsEmpty(Window.Property(sbsearch.keys))">123 / #</value>
        <value>ABC</value>
    </variable>
    <variable name="StremioSearchListTitle">
        <value condition="String.IsEmpty(Window(home).Property(sbsearch.query))">Recent searches</value>
        <value>Suggestions</value>
    </variable>
    <variable name="StremioSearchHint">
        <value condition="String.IsEmpty(Window(home).Property(sbsearch.query))">Type to search movies and TV shows</value>
        <value>No results for "$INFO[Window(home).Property(sbsearch.query)]"</value>
    </variable>

