<?xml version="1.0" encoding="UTF-8"?>
<!-- Arctic Zephyr Stremio additions. -->
<includes>
    <!-- The info page (DialogVideoInfo.xml): is it one of Stremio Bridge's titles, and
         which of its buttons apply. Before the dialog's onload has run these read the
         item; afterwards its frozen sbinfo.* copy (ListItem.* follows focused lists). -->
    <expression name="SBInfoPage">[String.IsEmpty(Window(home).Property(sbinfo.id)) + !String.IsEmpty(ListItem.Property(stremiobridge.id))] | !String.IsEmpty(Window(home).Property(sbinfo.id))</expression>
    <expression name="SBInfoBrowse">[String.IsEmpty(Window(home).Property(sbinfo.id)) + !String.IsEmpty(ListItem.Property(stremiobridge.browse))] | !String.IsEmpty(Window(home).Property(sbinfo.browse))</expression>
    <expression name="SBInfoSimilar">[String.IsEmpty(Window(home).Property(sbinfo.id)) + !String.IsEmpty(ListItem.Property(stremiobridge.similar))] | !String.IsEmpty(Window(home).Property(sbinfo.similar))</expression>
    <expression name="SBInfoWatchlist">[String.IsEmpty(Window(home).Property(sbinfo.id)) + !String.IsEmpty(ListItem.Property(stremiobridge.watchlist_action))] | !String.IsEmpty(Window(home).Property(sbinfo.watchlist_action))</expression>
    <expression name="SBInfoListed">[String.IsEmpty(Window(home).Property(sbinfo.id)) + String.IsEqual(ListItem.Property(stremiobridge.watchlist),true)] | String.IsEqual(Window(home).Property(sbinfo.watchlist),true)</expression>
    <expression name="SBInfoWatched">[String.IsEmpty(Window(home).Property(sbinfo.id)) + Integer.IsGreater(ListItem.PlayCount,0)] | !String.IsEmpty(Window(home).Property(sbinfo.watched))</expression>
    <expression name="SBInfoResumable">[String.IsEmpty(Window(home).Property(sbinfo.id)) + ListItem.IsResumable] | !String.IsEmpty(Window(home).Property(sbinfo.resumable))</expression>
    <expression name="SBInfoHeaderLogo">Skin.HasSetting(view.netflix.clearlogo) + $EXP[SBInfoPage] + !String.IsEmpty(Window(home).Property(sbinfo.clearlogo))</expression>
    <expression name="SBInfoShowLevel">String.IsEmpty(Window(home).Property(sbinfo.video)) + !String.IsEmpty(Window(home).Property(sbinfo.browse))</expression>

