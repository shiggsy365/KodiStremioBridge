<?xml version="1.0" encoding="UTF-8"?>
<!-- BingeTV: settings dialogs (the OSD's audio, subtitle and video settings among them) as a panel
     down the right-hand side, so the video stays in view: the heading with a red rule, rows that
     turn red when focused, red switches, and the dialog's buttons along the bottom. -->
<window>
	<defaultcontrol>5</defaultcontrol>
	<animation type="WindowOpen" reversible="false">
		<effect type="slide" start="780,0" end="0,0" time="260" tween="cubic" easing="out" />
		<effect type="fade" start="0" end="100" time="200" />
	</animation>
	<animation type="WindowClose" reversible="false">
		<effect type="slide" start="0,0" end="780,0" time="220" tween="cubic" easing="in" />
		<effect type="fade" start="100" end="0" time="200" />
	</animation>
	<controls>
		<control type="group">
			<left>1140</left>
			<width>780</width>
			<visible>!Window.IsVisible(sliderdialog)</visible>
			<animation effect="fade" time="200">VisibleChange</animation>
			<control type="image">
				<left>-120</left>
				<width>120</width>
				<height>1080</height>
				<texture colordiffuse="99000000" flipx="true">bingetv/fade_right.png</texture>
			</control>
			<control type="image">
				<width>780</width>
				<height>1080</height>
				<texture colordiffuse="F215171C">bingetv/white.png</texture>
			</control>
			<control type="label" id="2">
				<left>50</left>
				<top>54</top>
				<width>680</width>
				<height>56</height>
				<aligny>center</aligny>
				<font>SBInfoHeading</font>
				<textcolor>FFFFFFFF</textcolor>
			</control>
			<control type="image">
				<left>50</left>
				<top>118</top>
				<width>64</width>
				<height>4</height>
				<texture colordiffuse="btv_accent">bingetv/white.png</texture>
			</control>
			<control type="grouplist" id="5">
				<description>control area</description>
				<left>30</left>
				<top>150</top>
				<width>700</width>
				<height>770</height>
				<itemgap>6</itemgap>
				<pagecontrol>60</pagecontrol>
				<onleft>noop</onleft>
				<onright>60</onright>
				<onup>5</onup>
				<ondown>9000</ondown>
			</control>
			<control type="button" id="7">
				<description>Default Button</description>
				<include>BTVSettingRow</include>
			</control>
			<control type="radiobutton" id="8">
				<description>Default RadioButton</description>
				<include>BTVSettingRow</include>
				<include content="BTVSettingSwitch"><param name="x">610</param></include>
			</control>
			<control type="spincontrolex" id="9">
				<description>Default SpinControlex</description>
				<include>BTVSettingRow</include>
				<spinwidth>26</spinwidth>
				<spinheight>40</spinheight>
			</control>
			<control type="image" id="11">
				<description>separator image</description>
				<width>700</width>
				<height>2</height>
				<texture colordiffuse="1FFFFFFF">bingetv/white.png</texture>
			</control>
			<control type="edit" id="12">
				<include>BTVSettingRow</include>
			</control>
			<control type="sliderex" id="13">
				<description>Default Slider</description>
				<include>BTVSettingRow</include>
				<textwidth>440</textwidth>
				<sliderwidth>200</sliderwidth>
				<sliderheight>24</sliderheight>
				<textureslidernibfocus colordiffuse="FFFFFFFF">buttons/slider-nib.png</textureslidernibfocus>
			</control>
			<control type="label" id="14">
				<description>Default Label</description>
				<width>700</width>
				<height>60</height>
				<textoffsetx>28</textoffsetx>
				<aligny>center</aligny>
				<font>btv_small</font>
				<textcolor>FF8A8A8A</textcolor>
			</control>
			<control type="grouplist" id="9000">
				<left>30</left>
				<top>950</top>
				<width>700</width>
				<height>64</height>
				<orientation>horizontal</orientation>
				<itemgap>14</itemgap>
				<onup>5</onup>
				<ondown>noop</ondown>
				<onleft>9000</onleft>
				<onright>9000</onright>
				<include content="BTVSettingDialogButton"><param name="id">28</param></include>
				<include content="BTVSettingDialogButton"><param name="id">29</param></include>
				<include content="BTVSettingDialogButton"><param name="id">30</param></include>
			</control>
			<control type="scrollbar" id="60">
				<left>742</left>
				<top>150</top>
				<width>6</width>
				<height>770</height>
				<orientation>vertical</orientation>
				<texturesliderbackground colordiffuse="14FFFFFF">bingetv/white.png</texturesliderbackground>
				<texturesliderbar colordiffuse="66FFFFFF">bingetv/white.png</texturesliderbar>
				<texturesliderbarfocus colordiffuse="btv_accent">bingetv/white.png</texturesliderbarfocus>
				<onleft>5</onleft>
				<onright>noop</onright>
			</control>
			<control type="gamecontroller" id="100">
				<top>560</top>
				<right>40</right>
				<height>290</height>
				<width>290</width>
			</control>
		</control>
	</controls>
</window>
