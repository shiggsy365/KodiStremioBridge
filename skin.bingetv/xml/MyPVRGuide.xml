<?xml version="1.0" encoding="UTF-8"?>
<!-- BingeTV TV guide (Live TV on the menu bar): Arctic Zephyr Stremio's full-screen guide in
     BingeTV's colours. Channel groups as tabs along the top (11, filled by Kodi) with the guide's
     options, "full guide" and the clock on the right; the focused programme under them; the grid
     below (a slim time ruler, then as many 70px rows as fit: 11, or 13 with "full guide", which
     hides the programme info). Focus is red with white text, as everywhere in BingeTV. -->
<window>
	<menucontrol>9000</menucontrol>
	<defaultcontrol always="true">10</defaultcontrol>
	<views>10,12</views>
	<controls>
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="primary_background">bingetv/white.png</texture>
		</control>
		<control type="group">
			<left>20</left>
			<right>20</right>
			<top>10</top>
			<bottom>10</bottom>
			<animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
			<control type="image">
				<left>-8</left>
				<right>-8</right>
				<top>-8</top>
				<bottom>-8</bottom>
				<texture colordiffuse="dialog_tint" border="32">bingetv/panel.png</texture>
			</control>

			<!-- Top bar: channel groups, the guide's options, full guide, clock -->
			<control type="image">
				<width>1880</width>
				<height>70</height>
				<texture colordiffuse="1FFFFFFF" border="32">bingetv/panel.png</texture>
			</control>
			<control type="list" id="11">
				<left>0</left>
				<top>3</top>
				<width>1420</width>
				<height>64</height>
				<onup condition="!Control.IsVisible(12)">10</onup>
				<onup condition="Control.IsVisible(12)">12</onup>
				<ondown condition="!Control.IsVisible(12)">10</ondown>
				<ondown condition="Control.IsVisible(12)">12</ondown>
				<onright>11441</onright>
				<onleft>11442</onleft>
				<orientation>horizontal</orientation>
				<viewtype label="535">list</viewtype>
				<scrolltime tween="quadratic">400</scrolltime>
				<itemlayout width="230" height="64">
					<control type="label">
						<left>6</left>
						<top>8</top>
						<width>218</width>
						<height>48</height>
						<align>center</align>
						<aligny>center</aligny>
						<font>SBInfoTab</font>
						<textcolor>FFA0A0A0</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout width="230" height="64">
					<control type="image">
						<left>6</left>
						<top>8</top>
						<width>218</width>
						<height>48</height>
						<texture border="20" colordiffuse="btv_accent">bingetv/pill.png</texture>
						<visible>Control.HasFocus(11)</visible>
					</control>
					<control type="image">
						<left>6</left>
						<top>8</top>
						<width>218</width>
						<height>48</height>
						<texture border="20" colordiffuse="40FFFFFF">bingetv/pill.png</texture>
						<visible>!Control.HasFocus(11)</visible>
					</control>
					<control type="label">
						<left>6</left>
						<top>8</top>
						<width>218</width>
						<height>48</height>
						<align>center</align>
						<aligny>center</aligny>
						<font>SBInfoTab</font>
						<textcolor>FFFFFFFF</textcolor>
						<label>[B]$INFO[ListItem.Label][/B]</label>
					</control>
				</focusedlayout>
			</control>
			<!-- the guide's options (Kodi's side menu: channel groups, search, ...) -->
			<control type="button" id="11441">
				<left>1430</left>
				<top>3</top>
				<width>64</width>
				<height>64</height>
				<label>$LOCALIZE[33063]</label>
				<textcolor>00FFFFFF</textcolor>
				<focusedcolor>00FFFFFF</focusedcolor>
				<texturenofocus>bingetv/bar/settings_nf.png</texturenofocus>
				<texturefocus>bingetv/bar/settings_fo.png</texturefocus>
				<onup condition="!Control.IsVisible(12)">10</onup>
				<onup condition="Control.IsVisible(12)">12</onup>
				<ondown condition="!Control.IsVisible(12)">10</ondown>
				<ondown condition="Control.IsVisible(12)">12</ondown>
				<onleft>11</onleft>
				<onright>11442</onright>
				<onclick>SetFocus(9000)</onclick>
			</control>
			<!-- full guide: two more rows, without the programme info -->
			<control type="button" id="11442">
				<left>1500</left>
				<top>3</top>
				<width>64</width>
				<height>64</height>
				<label>Full guide</label>
				<textcolor>00FFFFFF</textcolor>
				<focusedcolor>00FFFFFF</focusedcolor>
				<texturenofocus>bingetv/bar/more_nf.png</texturenofocus>
				<texturefocus>bingetv/bar/more_fo.png</texturefocus>
				<onup condition="!Control.IsVisible(12)">10</onup>
				<onup condition="Control.IsVisible(12)">12</onup>
				<ondown condition="!Control.IsVisible(12)">10</ondown>
				<ondown condition="Control.IsVisible(12)">12</ondown>
				<onleft>11441</onleft>
				<onright>SetFocus(11,0,absolute)</onright>
				<onclick condition="Control.IsVisible(12)">Container.SetViewMode(10)</onclick>
				<onclick condition="Control.IsVisible(10)">Container.SetViewMode(12)</onclick>
			</control>
			<control type="label">
				<right>20</right>
				<width>300</width>
				<height>70</height>
				<align>right</align>
				<aligny>center</aligny>
				<font>SBInfoHeading</font>
				<textcolor>btv_accent</textcolor>
				<label>$INFO[System.Time]</label>
			</control>

			<include content="BTVGuideGrid">
				<param name="id">10</param>
				<param name="top">248</param>
				<param name="height">810</param>
				<param name="line">bingetv/progressline.png</param>
				<param name="label">19069</param>
			</include>
			<!-- full guide: two more rows, no programme info -->
			<include content="BTVGuideGrid">
				<param name="id">12</param>
				<param name="top">72</param>
				<param name="height">950</param>
				<param name="line">bingetv/progressline2.png</param>
				<param name="label">19032</param>
			</include>

			<!-- The focused programme: under the tab bar, above the grid -->
			<control type="group">
				<top>78</top>
				<height>164</height>
				<left>30</left>
				<right>20</right>
				<visible>!Control.IsVisible(12)</visible>
				<control type="label">
					<top>4</top>
					<right>280</right>
					<height>60</height>
					<aligny>center</aligny>
					<font>SBInfoHeading</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[ListItem.Title]</label>
				</control>
				<control type="label">
					<top>4</top>
					<right>270</right>
					<width>600</width>
					<height>60</height>
					<align>right</align>
					<aligny>center</aligny>
					<font>SBInfoFacts</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[ListItem.StartTime]$INFO[ListItem.EndTime, - ,]</label>
				</control>
				<control type="textbox">
					<top>68</top>
					<right>270</right>
					<height>90</height>
					<align>justify</align>
					<font>SBInfoBody</font>
					<textcolor>FFE0E0E0</textcolor>
					<label>$INFO[ListItem.Plot]</label>
				</control>
				<control type="image">
					<right>0</right>
					<top>8</top>
					<width>250</width>
					<height>150</height>
					<aspectratio align="center" aligny="center">keep</aspectratio>
					<texture>$VAR[BTVGuideImage]</texture>
					<fadetime>200</fadetime>
				</control>
			</control>
		</control>

		<include>PVRChannelNumberInput</include>
		<control type="group">
			<include>MediaMenuCommon</include>
			<include content="PVRSideBar">
				<param name="group_label2" value="$INFO[Control.GetLabel(30)]" />
			</include>
		</control>
		<control type="label" id="29">
			<font></font>
			<include>HiddenObject</include>
		</control>
		<control type="label" id="30">
			<font></font>
			<include>HiddenObject</include>
		</control>
	</controls>
</window>
