<?xml version="1.0" encoding="UTF-8"?>
<!-- BingeTV "Who's watching?": Kodi's profile picker (shown at start-up when it's turned on, or
     after logging off). The profiles (52, filled by Kodi) as big film avatars with the focused
     one in the middle, bigger and ringed in red; Exit BingeTV below. -->
<window>
	<defaultcontrol always="true">52</defaultcontrol>
	<!-- whoever is chosen, Home opens on its menu bar's Home button -->
	<onunload>SetProperty(btv.fromsettings,1,home)</onunload>
	<controls>
		<include content="BTVBackground">
			<param name="fanart">special://skin/resources/fanart.jpg</param>
		</include>
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="D915171C">bingetv/white.png</texture>
		</control>
		<control type="group">
			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<control type="image">
				<centerleft>50%</centerleft>
				<top>90</top>
				<width>360</width>
				<height>100</height>
				<aspectratio>keep</aspectratio>
				<texture>bingetv/logo.png</texture>
			</control>
			<control type="label">
				<left>0</left>
				<right>0</right>
				<top>250</top>
				<height>80</height>
				<align>center</align>
				<font>SBInfoTitle</font>
				<textcolor>FFFFFFFF</textcolor>
				<label>Who's watching?</label>
			</control>
		</control>
		<control type="fixedlist" id="52">
			<left>0</left>
			<right>0</right>
			<top>390</top>
			<height>420</height>
			<onleft>52</onleft>
			<onright>52</onright>
			<onup>20</onup>
			<ondown>20</ondown>
			<focusposition>2</focusposition>
			<movement>2</movement>
			<orientation>horizontal</orientation>
			<scrolltime tween="cubic" easing="out">400</scrolltime>
			<itemlayout width="384" height="420">
				<control type="image">
					<left>67</left>
					<top>40</top>
					<width>250</width>
					<height>250</height>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<texture diffuse="bingetv/panel.png" fallback="DefaultUser.png">$INFO[ListItem.Icon]</texture>
					<animation effect="fade" start="100" end="55" time="0" condition="true">Conditional</animation>
				</control>
				<control type="label">
					<left>20</left>
					<top>310</top>
					<width>344</width>
					<height>50</height>
					<align>center</align>
					<font>btv_line</font>
					<textcolor>FF9A9A9A</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout width="384" height="420">
				<control type="group">
					<animation effect="zoom" start="100" end="112" center="192,165" time="200" tween="cubic" easing="out" reversible="false">Focus</animation>
					<control type="image">
						<left>59</left>
						<top>32</top>
						<width>266</width>
						<height>266</height>
						<texture colordiffuse="btv_accent">bingetv/panel.png</texture>
						<visible>Control.HasFocus(52)</visible>
					</control>
					<control type="image">
						<left>67</left>
						<top>40</top>
						<width>250</width>
						<height>250</height>
						<aspectratio scalediffuse="false">scale</aspectratio>
						<texture diffuse="bingetv/panel.png" fallback="DefaultUser.png">$INFO[ListItem.Icon]</texture>
					</control>
				</control>
				<control type="label">
					<left>20</left>
					<top>318</top>
					<width>344</width>
					<height>50</height>
					<align>center</align>
					<font>SBInfoHeading</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
		</control>
		<!-- the focused profile's last visit -->
		<control type="label">
			<left>0</left>
			<right>0</right>
			<top>800</top>
			<height>40</height>
			<align>center</align>
			<font>btv_text</font>
			<textcolor>FF8A8A8A</textcolor>
			<label>$INFO[Container(52).ListItem.Label2]</label>
		</control>
		<control type="button" id="20">
			<centerleft>50%</centerleft>
			<top>900</top>
			<width>320</width>
			<height>64</height>
			<label>Exit BingeTV</label>
			<font>btv_line</font>
			<align>center</align>
			<aligny>center</aligny>
			<textcolor>FFDDDDDD</textcolor>
			<focusedcolor>FFFFFFFF</focusedcolor>
			<onclick>Quit</onclick>
			<onleft>52</onleft>
			<onright>52</onright>
			<onup>52</onup>
			<ondown>52</ondown>
			<texturefocus border="20" colordiffuse="btv_accent">bingetv/pill.png</texturefocus>
			<texturenofocus border="20" colordiffuse="26FFFFFF">bingetv/pill.png</texturenofocus>
		</control>
	</controls>
</window>
