<?xml version="1.0" encoding="utf-8"?>
<window>
	<defaultcontrol></defaultcontrol>
	<controls>
		<control type="group" id="0">
			<control type="label" id="10">
				<left>45</left>
				<top>15</top>
				<width>1770</width>
				<height>100</height>
				<label></label>
				<font>font12</font>
				<shadowcolor>black</shadowcolor>
			</control>
			<control type="label" id="11">
				<left>45</left>
				<top>45</top>
				<width>1770</width>
				<height>100</height>
				<label></label>
				<font>font12</font>
				<shadowcolor>black</shadowcolor>
			</control>
			<control type="label" id="12">
				<left>45</left>
				<top>75</top>
				<width>1770</width>
				<height>100</height>
				<label></label>
				<font>font12</font>
				<shadowcolor>black</shadowcolor>
			</control>
		</control>
		<control type="group" id="1">
			<depth>DepthOSD+</depth>
			<visible>Player.Caching + Integer.IsGreater(Player.CacheLevel,0)</visible>
			<animation effect="fade" delay="300" time="200">Visible</animation>
			<animation effect="fade" delay="200" time="150">Hidden</animation>
			<centerleft>50%</centerleft>
			<width>110</width>
			<centertop>50%</centertop>
			<height>110</height>
			<control type="image" id="1">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>110</width>
				<height>110</height>
				<texture colordiffuse="BFFFFFFF">osd/buffer-bg.png</texture>
			</control>
			<control type="image" id="1">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>92</width>
				<height>92</height>
				<texture>dialogs/extendedprogress/loading-back.png</texture>
			</control>
			<control type="image" id="1">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>92</width>
				<height>92</height>
				<texture colordiffuse="button_focus">$INFO[Player.CacheLevel,dialogs/volume/progress/p,.png]</texture>
			</control>
			<control type="label" id="1">
				<description>buffering value</description>
				<label>$INFO[Player.CacheLevel]</label>
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>200</width>
				<height>200</height>
				<aligny>center</aligny>
				<align>center</align>
				<font>font13</font>
			</control>
		</control>
		<!-- BingeTV: Stremio Bridge is getting a title ready (stremiobridge.preparing, set when it
		     hands Kodi the stream, cleared once the video starts): the title's page, not a spinner. -->
		<control type="group">
			<visible>!String.IsEmpty(Window(Home).Property(stremiobridge.preparing))</visible>
			<include content="BTVPreparingPage">
				<param name="fanart">Window(Home).Property(stremiobridge.preparing.fanart)</param>
				<param name="logo">Window(Home).Property(stremiobridge.preparing.logo)</param>
				<param name="title">Window(Home).Property(stremiobridge.preparing.title)</param>
				<param name="subtitle">Window(Home).Property(stremiobridge.preparing.subtitle)</param>
				<param name="status">Window(Home).Property(stremiobridge.preparing.status)</param>
			</include>
		</control>
	</controls>
</window>
