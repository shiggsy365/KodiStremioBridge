<?xml version="1.0" encoding="UTF-8"?>
<!-- BingeTV OSD: round buttons on DialogSeekBar's bar, and the progress line to seek along (Up).
     It closes itself after 7 seconds without a key press (Custom_1160_OSDAutoClose.xml). -->
<window>
	<onload condition="!Player.PauseEnabled">SetFocus(603)</onload>
	<defaultcontrol always="true">602</defaultcontrol>
	<depth>DepthOSD</depth>
	<controls>
		<control type="group">
			<top>820</top>
			<animation effect="slide" start="0,260" end="0,0" time="200" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="slide" start="0,0" end="0,260" time="200" tween="cubic" easing="in">WindowClose</animation>
			<!-- Seeking: Up from the buttons, then Left / Right step back and forward -->
			<control type="group">
				<left>80</left>
				<top>77</top>
				<width>1760</width>
				<visible>Player.SeekEnabled</visible>
				<control type="button" id="87">
					<include>HiddenObject</include>
					<onup>noop</onup>
					<ondown>200</ondown>
					<onleft>StepBack</onleft>
					<onright condition="!Player.Paused">StepForward</onright>
					<onright condition="Player.Paused">PlayerControl(FrameAdvance(1))</onright>
				</control>
				<control type="slider">
					<width>1760</width>
					<height>26</height>
					<texturesliderbar colordiffuse="00FFFFFF">osd/progress/nub_leftright.png</texturesliderbar>
					<textureslidernib colordiffuse="FFFFFFFF">osd/progress/nub_leftright.png</textureslidernib>
					<textureslidernibfocus colordiffuse="FFFFFFFF">osd/progress/nub_leftright.png</textureslidernibfocus>
					<info>Player.Progress</info>
					<visible>Control.HasFocus(87) + !VideoPlayer.Content(LiveTV)</visible>
				</control>
				<control type="slider">
					<width>1760</width>
					<height>26</height>
					<texturesliderbar colordiffuse="00FFFFFF">osd/progress/nub_leftright.png</texturesliderbar>
					<textureslidernib colordiffuse="FFFFFFFF">osd/progress/nub_leftright.png</textureslidernib>
					<textureslidernibfocus colordiffuse="FFFFFFFF">osd/progress/nub_leftright.png</textureslidernibfocus>
					<info>PVR.TimeshiftProgressPlayPos</info>
					<visible>Control.HasFocus(87) + VideoPlayer.Content(LiveTV)</visible>
				</control>
			</control>
			<control type="grouplist" id="200">
				<left>80</left>
				<top>128</top>
				<width>1200</width>
				<height>66</height>
				<orientation>horizontal</orientation>
				<itemgap>18</itemgap>
				<onup condition="Player.SeekEnabled">87</onup>
				<ondown>noop</ondown>
				<control type="radiobutton" id="600">
					<include content="BTVOSDButton"><param name="icon">osd/fullscreen/buttons/previous.png</param></include>
					<onclick>PlayerControl(Previous)</onclick>
					<visible>Player.ChapterCount | Integer.IsGreater(Playlist.Length(video),1) | [Player.SeekEnabled + VideoPlayer.Content(livetv)]</visible>
				</control>
				<control type="radiobutton" id="601">
					<include content="BTVOSDButton"><param name="icon">osd/fullscreen/buttons/rewind.png</param></include>
					<onclick condition="Player.Paused">PlayerControl(Play)</onclick>
					<onclick condition="!Player.Paused">PlayerControl(Rewind)</onclick>
					<visible>Player.SeekEnabled + !VideoPlayer.Content(livetv)</visible>
				</control>
				<control type="radiobutton" id="602">
					<include content="BTVOSDButton"><param name="icon">osd/fullscreen/buttons/pause.png</param><param name="icon_on">osd/fullscreen/buttons/play.png</param><param name="selected">Player.Paused | Player.Forwarding | Player.Rewinding</param></include>
					<onclick>PlayerControl(Play)</onclick>
					<visible>Player.PauseEnabled</visible>
				</control>
				<control type="radiobutton" id="603">
					<include content="BTVOSDButton"><param name="icon">osd/fullscreen/buttons/stop.png</param></include>
					<onclick>PlayerControl(Stop)</onclick>
				</control>
				<control type="radiobutton" id="606">
					<include content="BTVOSDButton"><param name="icon">osd/fullscreen/buttons/forward.png</param></include>
					<onclick condition="Player.Paused">PlayerControl(Play)</onclick>
					<onclick condition="!Player.Paused">PlayerControl(Forward)</onclick>
					<visible>Player.SeekEnabled + !VideoPlayer.Content(livetv)</visible>
				</control>
				<control type="radiobutton" id="607">
					<include content="BTVOSDButton"><param name="icon">osd/fullscreen/buttons/next.png</param></include>
					<onclick>PlayerControl(Next)</onclick>
					<visible>Player.ChapterCount | Integer.IsGreater(Playlist.Length(video),1) | PVR.IsTimeShift</visible>
				</control>
				<control type="radiobutton" id="610">
					<include content="BTVOSDButton"><param name="icon">osd/fullscreen/buttons/streams.png</param></include>
					<onclick>ActivateWindow(osdaudiosettings)</onclick>
				</control>
				<control type="radiobutton" id="611">
					<include content="BTVOSDButton"><param name="icon">osd/fullscreen/buttons/settings-subtitle.png</param></include>
					<onclick>ActivateWindow(osdsubtitlesettings)</onclick>
				</control>
				<control type="radiobutton" id="612">
					<include content="BTVOSDButton"><param name="icon">osd/fullscreen/buttons/settings.png</param></include>
					<onclick>ActivateWindow(osdvideosettings)</onclick>
				</control>
				<control type="radiobutton" id="613">
					<include content="BTVOSDButton"><param name="icon">osd/fullscreen/buttons/channels.png</param></include>
					<onclick>ActivateWindow(PVROSDChannels)</onclick>
					<visible>VideoPlayer.Content(livetv)</visible>
				</control>
				<control type="radiobutton" id="614">
					<include content="BTVOSDButton"><param name="icon">osd/fullscreen/buttons/guide.png</param></include>
					<onclick>ActivateWindow(PVRChannelGuide)</onclick>
					<visible>VideoPlayer.Content(livetv)</visible>
				</control>
			</control>
		</control>
	</controls>
</window>
