<?xml version="1.0" encoding="UTF-8"?>
<!-- BingeTV: the screens rebuilt from Arctic Zephyr Stremio's layout (the rest is Estuary). -->
<includes>
	<!-- A title's background: the focused item's fanart, dimmed, darker towards the left and bottom. -->
	<include name="BTVBackground">
		<param name="fanart">$INFO[ListItem.Art(fanart)]</param>
		<definition>
			<control type="image">
				<width>1920</width>
				<height>1080</height>
				<texture colordiffuse="FF0E0F12">bingetv/white.png</texture>
			</control>
			<control type="image">
				<width>1920</width>
				<height>1080</height>
				<aspectratio>scale</aspectratio>
				<fadetime>400</fadetime>
				<texture background="true">$PARAM[fanart]</texture>
			</control>
			<control type="image">
				<width>1920</width>
				<height>1080</height>
				<texture colordiffuse="99000000">bingetv/white.png</texture>
			</control>
			<control type="image">
				<width>1300</width>
				<height>1080</height>
				<texture colordiffuse="E6000000">bingetv/fade_right.png</texture>
			</control>
			<control type="image">
				<top>480</top>
				<width>1920</width>
				<height>600</height>
				<texture colordiffuse="F2000000">bingetv/fade_down.png</texture>
			</control>
		</definition>
	</include>

	<!-- The focused title: clearlogo (or its name), two bold lines, genres and plot. -->
	<variable name="BTVLogo">
		<value condition="!String.IsEmpty(ListItem.Art(clearlogo))">$INFO[ListItem.Art(clearlogo)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.clearlogo))">$INFO[ListItem.Art(tvshow.clearlogo)]</value>
	</variable>
	<variable name="BTVTitle">
		<value condition="!String.IsEmpty(ListItem.TVShowTitle)">$INFO[ListItem.TVShowTitle]</value>
		<value>$INFO[ListItem.Title]</value>
	</variable>
	<variable name="BTVLine1">
		<value condition="!String.IsEmpty(ListItem.Episode)">S$INFO[ListItem.Season]$INFO[ListItem.Episode, E,  ]$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Property(ReleaseDate)]$VAR[BTVDuration,   ,]$INFO[ListItem.Rating,   ★ ,]</value>
	</variable>
	<!-- "1h 46m" (Kodi's own Duration is "01:46:00") -->
	<variable name="BTVDuration">
		<value condition="Integer.IsGreater(ListItem.Duration(h),0)">$INFO[ListItem.Duration(h)]h $INFO[ListItem.Duration(mm)]m</value>
		<value condition="!String.IsEmpty(ListItem.Duration)">$INFO[ListItem.Duration(mm)]m</value>
	</variable>
	<variable name="BTVLine2">
		<value condition="!String.IsEmpty(ListItem.Episode)">$INFO[ListItem.Property(ReleaseDate)]</value>
	</variable>
	<variable name="BTVGenres">
		<value condition="!String.IsEmpty(ListItem.Property(stremiobridge.genres))">$INFO[ListItem.Property(stremiobridge.genres)]</value>
		<value>$INFO[ListItem.Genre]</value>
	</variable>
	<include name="BTVTitleInfo">
		<param name="plot">242</param>
		<definition>
		<control type="group">
			<left>80</left>
			<top>110</top>
			<control type="image">
				<width>360</width>
				<height>130</height>
				<aspectratio align="left" aligny="center">keep</aspectratio>
				<fadetime>300</fadetime>
				<texture background="true">$VAR[BTVLogo]</texture>
			</control>
			<control type="label">
				<top>50</top>
				<width>1300</width>
				<height>70</height>
				<font>font52_title</font>
				<textcolor>FFFFFFFF</textcolor>
				<label>$VAR[BTVTitle]</label>
				<visible>String.IsEmpty(ListItem.Art(clearlogo)) + String.IsEmpty(ListItem.Art(tvshow.clearlogo))</visible>
			</control>
			<control type="grouplist">
				<top>145</top>
				<width>1400</width>
				<height>370</height>
				<orientation>vertical</orientation>
				<itemgap>1</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width>1400</width>
					<height>40</height>
					<font>btv_line</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$VAR[BTVLine1]</label>
				</control>
				<control type="label">
					<width>1400</width>
					<height>40</height>
					<font>btv_line</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$VAR[BTVLine2]</label>
					<visible>!String.IsEmpty(ListItem.Episode)</visible>
				</control>
				<control type="label">
					<width>1400</width>
					<height>40</height>
					<font>btv_text</font>
					<textcolor>FFB4B4B4</textcolor>
					<label>$VAR[BTVGenres]</label>
				</control>
				<control type="textbox">
					<width>1050</width>
					<height>$PARAM[plot]</height>
					<font>btv_text</font>
					<textcolor>FFEEEEEE</textcolor>
					<autoscroll delay="6000" time="3000" repeat="8000">true</autoscroll>
					<label>$INFO[ListItem.Plot]</label>
				</control>
			</control>
		</control>
		</definition>
	</include>

	<!-- Home's rows: Stremio Bridge's sbhome.<item>.widgetPath / widgetName (".2" to ".6" for
	     rows 2-6), one shown at a time. Up/Down move between rows that have a list (row 1's
	     Up goes to the menu); the rows slide so the current one stays in place. -->
	<include name="BTVHomeRows">
		<param name="item">10000</param>
		<param name="base">910</param>
		<param name="menu">9201</param>
		<definition>
			<control type="group">
				<top>635</top>
				<visible>String.IsEqual(Window(Home).Property(btv.menu),$PARAM[item])</visible>
				<animation effect="slide" end="0,-400" time="300" tween="cubic" easing="out" condition="String.IsEqual(Window(Home).Property(btv.row),2)">Conditional</animation>
				<animation effect="slide" end="0,-800" time="300" tween="cubic" easing="out" condition="String.IsEqual(Window(Home).Property(btv.row),3)">Conditional</animation>
				<animation effect="slide" end="0,-1200" time="300" tween="cubic" easing="out" condition="String.IsEqual(Window(Home).Property(btv.row),4)">Conditional</animation>
				<animation effect="slide" end="0,-1600" time="300" tween="cubic" easing="out" condition="String.IsEqual(Window(Home).Property(btv.row),5)">Conditional</animation>
				<animation effect="slide" end="0,-2000" time="300" tween="cubic" easing="out" condition="String.IsEqual(Window(Home).Property(btv.row),6)">Conditional</animation>
				<include content="BTVPosterRow"><param name="n">1</param><param name="base">$PARAM[base]</param><param name="prev">$PARAM[menu]</param><param name="later">false</param><param name="next">$PARAM[base]2</param><param name="top">0</param><param name="item">$PARAM[item]</param><param name="slot" value="" /><param name="nextslot">.2</param></include>
				<include content="BTVPosterRow"><param name="n">2</param><param name="base">$PARAM[base]</param><param name="prev">$PARAM[base]1</param><param name="next">$PARAM[base]3</param><param name="top">400</param><param name="item">$PARAM[item]</param><param name="slot">.2</param><param name="nextslot">.3</param></include>
				<include content="BTVPosterRow"><param name="n">3</param><param name="base">$PARAM[base]</param><param name="prev">$PARAM[base]2</param><param name="next">$PARAM[base]4</param><param name="top">800</param><param name="item">$PARAM[item]</param><param name="slot">.3</param><param name="nextslot">.4</param></include>
				<include content="BTVPosterRow"><param name="n">4</param><param name="base">$PARAM[base]</param><param name="prev">$PARAM[base]3</param><param name="next">$PARAM[base]5</param><param name="top">1200</param><param name="item">$PARAM[item]</param><param name="slot">.4</param><param name="nextslot">.5</param></include>
				<include content="BTVPosterRow"><param name="n">5</param><param name="base">$PARAM[base]</param><param name="prev">$PARAM[base]4</param><param name="next">$PARAM[base]6</param><param name="top">1600</param><param name="item">$PARAM[item]</param><param name="slot">.5</param><param name="nextslot">.6</param></include>
				<include content="BTVPosterRow"><param name="n">6</param><param name="base">$PARAM[base]</param><param name="prev">$PARAM[base]5</param><param name="next">$PARAM[base]6</param><param name="top">2000</param><param name="item">$PARAM[item]</param><param name="slot">.6</param><param name="nextslot">.7</param></include>
			</control>
		</definition>
	</include>
	<include name="BTVPosterRow">
		<param name="n" />
		<param name="top" />
		<param name="item" />
		<param name="slot" />
		<param name="nextslot" />
		<param name="base" />
		<param name="prev" />
		<param name="next" />
		<param name="later">true</param>
		<definition>
			<control type="group">
				<top>$PARAM[top]</top>
				<!-- Only the current row shows (row 1 until another has had focus). -->
				<animation effect="fade" start="100" end="0" time="200" condition="!String.IsEmpty(Window(Home).Property(btv.row)) + !String.IsEqual(Window(Home).Property(btv.row),$PARAM[n])">Conditional</animation>
				<animation effect="fade" start="100" end="0" time="0" condition="String.IsEmpty(Window(Home).Property(btv.row)) + $PARAM[later]">Conditional</animation>
				<visible>!String.IsEmpty(Window(Home).Property(sbhome.$PARAM[item].widgetPath$PARAM[slot]))</visible>
				<control type="label">
					<left>80</left>
					<width>1400</width>
					<height>44</height>
					<font>btv_row</font>
					<textcolor>FFDDDDDD</textcolor>
					<label>$INFO[Window(Home).Property(sbhome.$PARAM[item].widgetName$PARAM[slot])]</label>
				</control>
				<control type="list" id="$PARAM[base]$PARAM[n]">
					<left>66</left>
					<top>53</top>
					<width>1854</width>
					<height>330</height>
					<orientation>horizontal</orientation>
					<scrolltime tween="cubic" easing="out">260</scrolltime>
					<onfocus>SetProperty(btv.row,$PARAM[n],home)</onfocus>
					<onfocus>CancelAlarm(btvfocus1,true)</onfocus>
					<onfocus>CancelAlarm(btvfocus2,true)</onfocus>
					<onfocus>CancelAlarm(btvhubfocus1,true)</onfocus>
					<onfocus>CancelAlarm(btvhubfocus2,true)</onfocus>
					<onup>SetFocus($PARAM[prev])</onup>
					<ondown condition="!String.IsEmpty(Window(Home).Property(sbhome.$PARAM[item].widgetPath$PARAM[nextslot]))">SetFocus($PARAM[next])</ondown>
					<onclick condition="String.Contains(ListItem.FileNameAndPath,plugin.video.stremiobridge/?action=extended_info)">RunPlugin($ESCINFO[ListItem.FileNameAndPath])</onclick>
					<itemlayout width="222" height="330">
						<include>BTVPoster</include>
					</itemlayout>
					<focusedlayout width="222" height="330">
						<control type="image">
							<width>216</width>
							<height>319</height>
							<texture colordiffuse="btv_accent">bingetv/poster_focus.png</texture>
							<visible>Control.HasFocus($PARAM[base]$PARAM[n])</visible>
						</control>
						<include>BTVPoster</include>
					</focusedlayout>
					<content target="videos">$INFO[Window(Home).Property(sbhome.$PARAM[item].widgetPath$PARAM[slot])]</content>
				</control>
			</control>
		</definition>
	</include>
	<include name="BTVPoster">
		<control type="image">
			<left>7</left>
			<top>7</top>
			<width>202</width>
			<height>305</height>
			<aspectratio>scale</aspectratio>
			<texture background="true" diffuse="bingetv/poster_mask.png" fallback="DefaultVideo.png">$INFO[ListItem.Art(poster)]</texture>
		</control>
		<control type="image">
			<left>89</left>
			<top>7</top>
			<width>120</width>
			<height>120</height>
			<texture>bingetv/paused_corner.png</texture>
			<visible>ListItem.IsResumable</visible>
		</control>
	</include>
	<!-- A poster's name underneath it (hub pages). -->
	<include name="BTVPosterName">
		<control type="label">
			<left>7</left>
			<top>320</top>
			<width>202</width>
			<height>34</height>
			<font>font12</font>
			<textcolor>FFDDDDDD</textcolor>
			<label>$INFO[ListItem.Label]</label>
		</control>
	</include>
	<variable name="BTVHomeFanart">
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),movies) + String.IsEqual(Window(Home).Property(btv.row),1)">$INFO[Container(9111).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),movies) + String.IsEqual(Window(Home).Property(btv.row),2)">$INFO[Container(9112).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),movies) + String.IsEqual(Window(Home).Property(btv.row),3)">$INFO[Container(9113).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),movies) + String.IsEqual(Window(Home).Property(btv.row),4)">$INFO[Container(9114).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),movies) + String.IsEqual(Window(Home).Property(btv.row),5)">$INFO[Container(9115).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),movies) + String.IsEqual(Window(Home).Property(btv.row),6)">$INFO[Container(9116).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),tvshows) + String.IsEqual(Window(Home).Property(btv.row),1)">$INFO[Container(9121).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),tvshows) + String.IsEqual(Window(Home).Property(btv.row),2)">$INFO[Container(9122).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),tvshows) + String.IsEqual(Window(Home).Property(btv.row),3)">$INFO[Container(9123).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),tvshows) + String.IsEqual(Window(Home).Property(btv.row),4)">$INFO[Container(9124).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),tvshows) + String.IsEqual(Window(Home).Property(btv.row),5)">$INFO[Container(9125).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),tvshows) + String.IsEqual(Window(Home).Property(btv.row),6)">$INFO[Container(9126).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),10000) + String.IsEqual(Window(Home).Property(btv.row),1)">$INFO[Container(9101).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),10000) + String.IsEqual(Window(Home).Property(btv.row),2)">$INFO[Container(9102).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),10000) + String.IsEqual(Window(Home).Property(btv.row),3)">$INFO[Container(9103).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),10000) + String.IsEqual(Window(Home).Property(btv.row),4)">$INFO[Container(9104).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),10000) + String.IsEqual(Window(Home).Property(btv.row),5)">$INFO[Container(9105).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(Home).Property(btv.menu),10000) + String.IsEqual(Window(Home).Property(btv.row),6)">$INFO[Container(9106).ListItem.Art(fanart)]</value>
	</variable>

	<!-- The menu along the top: where you are and the sections on the left; search, settings,
	     (power) and the time on the right. Down returns to the row you were on. -->
	<expression name="BTVMenuFocused">ControlGroup(9200).HasFocus | ControlGroup(9210).HasFocus</expression>
	<include name="BTVTopBar">
		<param name="title">$LOCALIZE[10000]</param>
		<param name="down">$INFO[Window(Home).Property(btv.rowbase)]$INFO[Window(Home).Property(btv.row)]</param>
		<param name="home">SetFocus(9101)</param>
		<definition>
		<control type="group">
			<control type="image">
				<width>1920</width>
				<height>140</height>
				<texture colordiffuse="CC000000" flipy="true">bingetv/fade_down.png</texture>
			</control>
			<control type="label">
				<left>80</left>
				<top>18</top>
				<width>170</width>
				<height>60</height>
				<font>btv_menu</font>
				<textcolor>FFDDDDDD</textcolor>
				<label>$PARAM[title]</label>
				<visible>!$EXP[BTVMenuFocused]</visible>
			</control>
			<control type="label">
				<left>80</left>
				<top>18</top>
				<width>170</width>
				<height>60</height>
				<font>btv_menu</font>
				<textcolor>FFFFFFFF</textcolor>
				<label>$INFO[System.CurrentControl]</label>
				<visible>$EXP[BTVMenuFocused]</visible>
			</control>
			<control type="grouplist" id="9200">
				<left>250</left>
				<top>18</top>
				<width>700</width>
				<height>60</height>
				<orientation>horizontal</orientation>
				<itemgap>0</itemgap>
				<onright>9210</onright>
					<ondown>SetFocus($PARAM[down])</ondown>
					<control type="button" id="9201">
						<onfocus>CancelAlarm(btvfocus1,true)</onfocus>
						<onfocus>CancelAlarm(btvfocus2,true)</onfocus>
						<onfocus>CancelAlarm(btvhubfocus1,true)</onfocus>
						<onfocus>CancelAlarm(btvhubfocus2,true)</onfocus>
						<onfocus condition="Window.IsActive(Home) + !String.IsEqual(Window(Home).Property(btv.menu),10000)">SetProperty(btv.row,1,home)</onfocus>
						<onfocus condition="Window.IsActive(Home)">SetProperty(btv.menu,10000,home)</onfocus>
						<onfocus condition="Window.IsActive(Home)">SetProperty(btv.rowbase,910,home)</onfocus>
						<width>64</width>
						<height>60</height>
						<label>$LOCALIZE[10000]</label>
						<textcolor>00FFFFFF</textcolor>
						<focusedcolor>00FFFFFF</focusedcolor>
						<texturenofocus>bingetv/bar/home_nf.png</texturenofocus>
						<texturefocus>bingetv/bar/home_fo.png</texturefocus>
						<onclick>$PARAM[home]</onclick>
					</control>
					<control type="button" id="9202">
						<onfocus>CancelAlarm(btvfocus1,true)</onfocus>
						<onfocus>CancelAlarm(btvfocus2,true)</onfocus>
						<onfocus>CancelAlarm(btvhubfocus1,true)</onfocus>
						<onfocus>CancelAlarm(btvhubfocus2,true)</onfocus>
						<onfocus condition="Window.IsActive(Home) + !String.IsEqual(Window(Home).Property(btv.menu),movies)">SetProperty(btv.row,1,home)</onfocus>
						<onfocus condition="Window.IsActive(Home)">SetProperty(btv.menu,movies,home)</onfocus>
						<onfocus condition="Window.IsActive(Home)">SetProperty(btv.rowbase,911,home)</onfocus>
						<width>64</width>
						<height>60</height>
						<label>$LOCALIZE[342]</label>
						<textcolor>00FFFFFF</textcolor>
						<focusedcolor>00FFFFFF</focusedcolor>
						<texturenofocus>bingetv/bar/movies_nf.png</texturenofocus>
						<texturefocus>bingetv/bar/movies_fo.png</texturefocus>
						<onclick>SetProperty(btv.hub,movies,home)</onclick>
						<onclick>SetProperty(btv.hubname,$LOCALIZE[342],home)</onclick>
						<onclick condition="!Window.IsActive(1150)">ActivateWindow(1150)</onclick>
						<onclick condition="Window.IsActive(1150)">SetFocus(300)</onclick>
					</control>
					<control type="button" id="9203">
						<onfocus>CancelAlarm(btvfocus1,true)</onfocus>
						<onfocus>CancelAlarm(btvfocus2,true)</onfocus>
						<onfocus>CancelAlarm(btvhubfocus1,true)</onfocus>
						<onfocus>CancelAlarm(btvhubfocus2,true)</onfocus>
						<onfocus condition="Window.IsActive(Home) + !String.IsEqual(Window(Home).Property(btv.menu),tvshows)">SetProperty(btv.row,1,home)</onfocus>
						<onfocus condition="Window.IsActive(Home)">SetProperty(btv.menu,tvshows,home)</onfocus>
						<onfocus condition="Window.IsActive(Home)">SetProperty(btv.rowbase,912,home)</onfocus>
						<width>64</width>
						<height>60</height>
						<label>$LOCALIZE[20343]</label>
						<textcolor>00FFFFFF</textcolor>
						<focusedcolor>00FFFFFF</focusedcolor>
						<texturenofocus>bingetv/bar/tv_nf.png</texturenofocus>
						<texturefocus>bingetv/bar/tv_fo.png</texturefocus>
						<onclick>SetProperty(btv.hub,tvshows,home)</onclick>
						<onclick>SetProperty(btv.hubname,$LOCALIZE[20343],home)</onclick>
						<onclick condition="!Window.IsActive(1150)">ActivateWindow(1150)</onclick>
						<onclick condition="Window.IsActive(1150)">SetFocus(300)</onclick>
					</control>
					<control type="button" id="9204">
						<onfocus>CancelAlarm(btvfocus1,true)</onfocus>
						<onfocus>CancelAlarm(btvfocus2,true)</onfocus>
						<onfocus>CancelAlarm(btvhubfocus1,true)</onfocus>
						<onfocus>CancelAlarm(btvhubfocus2,true)</onfocus>
						<width>64</width>
						<height>60</height>
						<label>$LOCALIZE[2]</label>
						<textcolor>00FFFFFF</textcolor>
						<focusedcolor>00FFFFFF</focusedcolor>
						<texturenofocus>bingetv/bar/music_nf.png</texturenofocus>
						<texturefocus>bingetv/bar/music_fo.png</texturefocus>
						<onclick>ActivateWindow(Music,root)</onclick>
					</control>
					<control type="button" id="9205">
						<onfocus>CancelAlarm(btvfocus1,true)</onfocus>
						<onfocus>CancelAlarm(btvfocus2,true)</onfocus>
						<onfocus>CancelAlarm(btvhubfocus1,true)</onfocus>
						<onfocus>CancelAlarm(btvhubfocus2,true)</onfocus>
						<width>64</width>
						<height>60</height>
						<label>Live TV</label>
						<textcolor>00FFFFFF</textcolor>
						<focusedcolor>00FFFFFF</focusedcolor>
						<texturenofocus>bingetv/bar/livetv_nf.png</texturenofocus>
						<texturefocus>bingetv/bar/livetv_fo.png</texturefocus>
						<onclick>ActivateWindow(TVChannels)</onclick>
						<visible>System.HasPVRAddon</visible>
					</control>
			</control>
			<control type="grouplist" id="9210">
				<right>290</right>
				<top>18</top>
				<width>400</width>
				<height>60</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>0</itemgap>
				<onleft>9200</onleft>
					<ondown>SetFocus($PARAM[down])</ondown>
					<control type="button" id="9211">
						<onfocus>CancelAlarm(btvfocus1,true)</onfocus>
						<onfocus>CancelAlarm(btvfocus2,true)</onfocus>
