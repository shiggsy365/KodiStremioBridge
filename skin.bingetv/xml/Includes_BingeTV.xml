	<!-- ============================================================ playback (OSD)
	     DialogSeekBar.xml: a banner along the top (logo or title, the episode, facts, genres, plot,
	     the clock) and the bar along the bottom (status, time, progress, finish time).
	     VideoOSD.xml: round buttons on that bar. -->
	<expression name="BTVOSDBanner">Window.IsVisible(videoosd) | Player.Paused | Player.ShowInfo | Window.IsVisible(fullscreeninfo)</expression>
	<variable name="BTVOSDLogo">
		<value condition="!String.IsEmpty(Player.Art(clearlogo))">$INFO[Player.Art(clearlogo)]</value>
		<value condition="!String.IsEmpty(Player.Art(tvshow.clearlogo))">$INFO[Player.Art(tvshow.clearlogo)]</value>
	</variable>
	<variable name="BTVOSDTitle">
		<value condition="!String.IsEmpty(VideoPlayer.TVShowTitle)">$INFO[VideoPlayer.TVShowTitle]</value>
		<value condition="VideoPlayer.Content(LiveTV)">$INFO[VideoPlayer.ChannelName]</value>
		<value>$INFO[VideoPlayer.Title]</value>
	</variable>
	<variable name="BTVOSDLine">
		<value condition="!String.IsEmpty(VideoPlayer.Episode)">S$INFO[VideoPlayer.Season]$INFO[VideoPlayer.Episode, E,  ]$INFO[VideoPlayer.Title]</value>
		<value condition="VideoPlayer.Content(LiveTV)">$INFO[VideoPlayer.Title]</value>
		<value>$INFO[VideoPlayer.Year]$INFO[VideoPlayer.Duration(h),   ,h ]$INFO[VideoPlayer.Duration(mm),,m]$INFO[VideoPlayer.Rating,   ★ ,]</value>
	</variable>
	<variable name="BTVOSDStatus">
		<value condition="Player.Caching">Buffering  $INFO[Player.CacheLevel]%</value>
		<value condition="Player.Paused">Paused</value>
		<value condition="Player.Forwarding">Fast forward  $INFO[Player.PlaySpeed,,x]</value>
		<value condition="Player.Rewinding">Rewind  $INFO[Player.PlaySpeed,,x]</value>
		<value>Playing</value>
	</variable>
	<variable name="BTVOSDTime">
		<value condition="VideoPlayer.Content(LiveTV)">$INFO[PVR.EpgEventElapsedTime]$INFO[PVR.EpgEventDuration,  /  ]</value>
		<value condition="!String.IsEmpty(Player.SeekNumeric)">$INFO[Player.SeekNumeric(hh:mm:ss)]$INFO[Player.Duration(hh:mm:ss),  /  ]</value>
		<value>$INFO[Player.Time(hh:mm:ss)]$INFO[Player.Duration(hh:mm:ss),  /  ]</value>
	</variable>
	<variable name="BTVOSDFinish">
		<value condition="VideoPlayer.Content(LiveTV)">$INFO[PVR.EpgEventFinishTime,Ends at ]</value>
		<value>$INFO[Player.FinishTime,Ends at ]</value>
	</variable>
