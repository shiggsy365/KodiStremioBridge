<?xml version="1.0" encoding="UTF-8"?>
<!-- BingeTV Home: the focused title at the top, Stremio Bridge's rows (sbhome.10000.*) below,
     one at a time, and the menu along the top. Up/Down moves between rows. -->
<window>
	<defaultcontrol always="true">9101</defaultcontrol>
	<onload condition="!Skin.HasSetting(stremio.setup_done) + System.HasAddon(plugin.video.stremiobridge)">RunPlugin(plugin://plugin.video.stremiobridge/?action=setup_wizard&amp;auto=1)</onload>
	<!-- The rows fill in after the window opens (a list without items can't take focus): give
	     focus to the row you were on (the first at start) once it has them. -->
	<onload condition="String.IsEmpty(Window(Home).Property(btv.row))">SetProperty(btv.row,1,home)</onload>
	<onload condition="String.IsEmpty(Window(Home).Property(btv.menu))">SetProperty(btv.menu,10000,home)</onload>
	<onload condition="String.IsEmpty(Window(Home).Property(btv.rowbase))">SetProperty(btv.rowbase,910,home)</onload>
	<onload condition="String.IsEmpty(Window(Home).Property(btv.fromsettings))">AlarmClock(btvfocus1,SetFocus($INFO[Window(Home).Property(btv.rowbase)]$INFO[Window(Home).Property(btv.row)]),00:02,silent)</onload>
	<onload condition="String.IsEmpty(Window(Home).Property(btv.fromsettings))">AlarmClock(btvfocus2,SetFocus($INFO[Window(Home).Property(btv.rowbase)]$INFO[Window(Home).Property(btv.row)]),00:05,silent)</onload>
	<!-- Back from Settings: the menu bar's Home button -->
	<onload condition="!String.IsEmpty(Window(Home).Property(btv.fromsettings))">SetFocus(9201)</onload>
	<onload>ClearProperty(btv.fromsettings,home)</onload>
	<controls>
		<include content="BTVBackground">
			<param name="fanart">$VAR[BTVHomeFanart]</param>
		</include>
		<control type="group">
			<visible>!$EXP[BTVMenuFocused]</visible>
			<include>Visible_Fade</include>
			<include>BTVTitleInfo</include>
		</control>
		<include content="BTVHomeRows"><param name="item">10000</param><param name="base">910</param><param name="menu">9201</param></include>
		<include content="BTVHomeRows"><param name="item">movies</param><param name="base">911</param><param name="menu">9202</param></include>
		<include content="BTVHomeRows"><param name="item">tvshows</param><param name="base">912</param><param name="menu">9203</param></include>
		<include>BTVTopBar</include>
	</controls>
</window>
