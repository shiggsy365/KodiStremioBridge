<?xml version="1.0" encoding="UTF-8"?>
<!-- BingeTV Home: the focused title at the top, Stremio Bridge's rows (sbhome.<menu item>.*) below,
     one at a time, and the menu along the top. Up/Down moves between rows. -->
<window>
	<defaultcontrol always="true">9101</defaultcontrol>
	<!-- Stremio Bridge's settings show the BingeTV-only tabs (Home page layout) when this is set -->
	<onload>SetProperty(btv.skin,1,home)</onload>
	<onload condition="!Skin.HasSetting(stremio.setup_done) + System.HasAddon(plugin.video.stremiobridge)">RunPlugin(plugin://plugin.video.stremiobridge/?action=setup_wizard&amp;auto=1)</onload>
	<!-- The rows fill in after the window opens (a list without items can't take focus): give
	     focus to the row you were on (the first at start) once it has them. -->
	<!-- Home's rows as they were last time (Stremio Bridge keeps them as skin settings, per profile:
	     homewidgets.remember_row), before its service has started: when a slot is empty, and always
	     after a profile switch (the home window's properties outlive it, with the last profile's rows) -->
	<onload condition="!String.IsEqual(Window(Home).Property(sbhome.profile),$INFO[System.ProfileName])">SetProperty(sbhome.10000.widgetPath,"$INFO[Skin.String(sbhome.10000.widgetPath)]",home)</onload>
	<onload condition="String.IsEmpty(Window(Home).Property(sbhome.10000.widgetPath)) + !String.IsEmpty(Skin.String(sbhome.10000.widgetPath))">SetProperty(sbhome.10000.widgetPath,"$INFO[Skin.String(sbhome.10000.widgetPath)]",home)</onload>
	<onload condition="!String.IsEqual(Window(Home).Property(sbhome.profile),$INFO[System.ProfileName])">SetProperty(sbhome.10000.widgetPath.2,"$INFO[Skin.String(sbhome.10000.widgetPath.2)]",home)</onload>
