<?xml version="1.0" encoding="UTF-8"?>
<!-- BingeTV's own settings (Settings > BingeTV, or Interface > Skin > Configure skin): the rows
     and menu bar, the player, touch screens, and a way to Stremio Bridge's settings. -->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<controls>
		<include content="BTVBackground">
			<param name="fanart">special://skin/resources/fanart.jpg</param>
		</include>
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="B315171C">bingetv/white.png</texture>
		</control>
		<control type="label">
			<left>80</left>
			<top>60</top>
			<width>1200</width>
			<height>70</height>
			<font>SBInfoTitle</font>
			<textcolor>FFFFFFFF</textcolor>
			<label>BingeTV settings</label>
		</control>
		<control type="image">
			<left>80</left>
			<top>138</top>
			<width>72</width>
			<height>5</height>
			<texture colordiffuse="btv_accent">bingetv/white.png</texture>
		</control>
		<control type="grouplist" id="9000">
			<left>66</left>
			<top>190</top>
			<width>1020</width>
			<height>820</height>
			<itemgap>8</itemgap>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<control type="button" id="101">
				<include content="BTVSettingRow"><param name="width">1000</param></include>
				<label>Home rows…</label>
				<label2>Home · Movies · TV Shows</label2>
				<onclick>RunPlugin(plugin://plugin.video.stremiobridge/?action=home_rows)</onclick>
			</control>
			<control type="radiobutton" id="102">
				<include content="BTVSettingRow"><param name="width">1000</param></include>
				<include content="BTVSettingSwitch"><param name="x">910</param></include>
				<label>Show Music on the menu bar</label>
				<selected>!Skin.HasSetting(btv.hidemusic)</selected>
				<onclick>Skin.ToggleSetting(btv.hidemusic)</onclick>
			</control>
			<control type="radiobutton" id="103">
				<include content="BTVSettingRow"><param name="width">1000</param></include>
				<include content="BTVSettingSwitch"><param name="x">910</param></include>
				<label>Show Live TV on the menu bar</label>
				<selected>!Skin.HasSetting(btv.hidelivetv)</selected>
				<onclick>Skin.ToggleSetting(btv.hidelivetv)</onclick>
			</control>
			<control type="radiobutton" id="104">
				<include content="BTVSettingRow"><param name="width">1000</param></include>
				<include content="BTVSettingSwitch"><param name="x">910</param></include>
				<label>Show the power button on the menu bar</label>
				<selected>Skin.HasSetting(btv.showpower)</selected>
				<onclick>Skin.ToggleSetting(btv.showpower)</onclick>
			</control>
			<control type="radiobutton" id="105">
				<include content="BTVSettingRow"><param name="width">1000</param></include>
				<include content="BTVSettingSwitch"><param name="x">910</param></include>
				<label>Show "Watched" and "Paused" ribbons</label>
				<selected>!Skin.HasSetting(btv.hideribbons)</selected>
				<onclick>Skin.ToggleSetting(btv.hideribbons)</onclick>
			</control>
			<control type="button" id="106">
				<include content="BTVSettingRow"><param name="width">1000</param></include>
				<label>Hide the player controls after</label>
				<label2>$VAR[BTVOSDHideLabel]</label2>
				<onclick>Skin.SelectBool(Hide the player controls after,3 seconds|btv.osd3,5 seconds|btv.osd5,7 seconds|btv.osd7,10 seconds|btv.osd10)</onclick>
			</control>
			<control type="radiobutton" id="107">
				<include content="BTVSettingRow"><param name="width">1000</param></include>
				<include content="BTVSettingSwitch"><param name="x">910</param></include>
				<label>Touch screen mode</label>
				<selected>Skin.HasSetting(touchmode)</selected>
				<onclick>Skin.ToggleSetting(touchmode)</onclick>
			</control>
			<control type="button" id="108">
				<include content="BTVSettingRow"><param name="width">1000</param></include>
				<label>Stremio Bridge settings…</label>
				<onclick>Addon.OpenSettings(plugin.video.stremiobridge)</onclick>
			</control>
		</control>
		<!-- What the focused setting does -->
		<control type="textbox">
			<left>1180</left>
			<top>200</top>
			<width>660</width>
			<height>400</height>
			<font>btv_text</font>
			<textcolor>FFB4B4B4</textcolor>
			<label>$VAR[BTVSkinSettingHelp]</label>
		</control>
		<control type="label">
			<left>1180</left>
			<bottom>60</bottom>
			<width>660</width>
			<height>40</height>
			<font>btv_small</font>
			<textcolor>FF6E6E6E</textcolor>
			<label>BingeTV skin $INFO[System.AddonVersion(skin.bingetv)]</label>
		</control>
	</controls>
</window>
