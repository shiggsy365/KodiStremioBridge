<?xml version="1.0" encoding="UTF-8"?>
<!-- BingeTV: the "Preparing to play" page held up behind Stremio Bridge's status and stream
     windows for as long as it prepares a title (Window(Home).Property(stremiobridge.preparing),
     see its statusbar.py), so the page stays put between the steps instead of what's underneath
     showing through. Kodi opens and closes it by its <visible>. -->
<window type="dialog" id="1161">
	<visible>!String.IsEmpty(Window(Home).Property(stremiobridge.preparing))</visible>
	<visible>!Player.HasVideo | Player.Paused</visible>
	<zorder>1</zorder>
	<animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="250">WindowClose</animation>
	<controls>
		<include content="BTVPreparingPage">
			<param name="fanart">Window(Home).Property(stremiobridge.preparing.fanart)</param>
			<param name="logo">Window(Home).Property(stremiobridge.preparing.logo)</param>
			<param name="title">Window(Home).Property(stremiobridge.preparing.title)</param>
			<param name="subtitle">Window(Home).Property(stremiobridge.preparing.subtitle)</param>
			<param name="status">Window(Home).Property(stremiobridge.preparing.status)</param>
		</include>
	</controls>
</window>
