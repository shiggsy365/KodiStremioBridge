<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.shiggsy365.tidycache"
       name="Tidy Cache"
       version="1.0.0"
       provider-name="shiggsy365">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
    </requires>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Keep Kodi's artwork cache and add-on downloads small</summary>
        <description lang="en_GB">Every few days, removes cached artwork Kodi hasn't shown recently and the add-on zips Kodi keeps after installing. Kodi downloads any artwork it needs again. Made for low-storage devices like Fire TV Sticks.</description>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
        <source>https://github.com/shiggsy365/KodiStremioBridge</source>
        <news>v1.0.0 - First release.</news>
        <assets>
            <icon>resources/icon.png</icon>
        </assets>
    </extension>
</addon>
