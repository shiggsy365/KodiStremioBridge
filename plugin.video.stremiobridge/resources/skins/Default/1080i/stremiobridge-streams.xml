<?xml version="1.0" encoding="UTF-8"?>
<!-- Stream picker: title header, filter chips (list 60), stream cards in two
     columns (panel 50) with a row of badge images. Filled by kodi_ui/streamwindow.py.
     1920x1080. -->
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <animation effect="fade" time="150">WindowOpen</animation>
    <animation effect="fade" time="150">WindowClose</animation>
    <controls>
        <!-- Backdrop: the title's fanart, dimmed -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF0B0E12">stremiobridge-white.png</texture>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <aspectratio>scale</aspectratio>
            <texture background="true" colordiffuse="38FFFFFF">$INFO[Window.Property(fanart)]</texture>
        </control>

        <!-- Header: logo (or title), then what this is and how many streams -->
        <control type="image">
            <left>80</left><top>36</top><width>620</width><height>130</height>
            <aspectratio aligny="center" align="left">keep</aspectratio>
            <texture background="true">$INFO[Window.Property(logo)]</texture>
            <visible>!String.IsEmpty(Window.Property(logo))</visible>
        </control>
        <control type="label">
            <left>80</left><top>60</top><width>1760</width><height>90</height>
            <font>font37</font><textcolor>FFFFFFFF</textcolor>
            <label>$INFO[Window.Property(title)]</label>
            <visible>String.IsEmpty(Window.Property(logo))</visible>
        </control>
        <control type="label">
            <left>80</left><top>170</top><width>1760</width><height>40</height>
            <font>font13</font><textcolor>FFBBBBBB</textcolor>
            <label>$INFO[Window.Property(subtitle)]</label>
        </control>

        <!-- Filter chips -->
        <control type="list" id="60">
            <left>80</left><top>222</top><width>1760</width><height>60</height>
            <orientation>horizontal</orientation>
            <onup>noop</onup>
            <ondown>50</ondown>
            <scrolltime>150</scrolltime>
            <itemlayout width="236" height="60">
                <control type="image">
                    <left>0</left><top>2</top><width>224</width><height>56</height>
                    <texture border="24" colordiffuse="FF1E2329">stremiobridge-card.png</texture>
                </control>
                <control type="image">
                    <left>0</left><top>2</top><width>224</width><height>56</height>
                    <texture border="24" colordiffuse="FF12A0C7">stremiobridge-card.png</texture>
                    <visible>String.IsEqual(ListItem.Property(active),1)</visible>
                </control>
                <control type="label">
                    <left>12</left><top>2</top><width>200</width><height>56</height>
                    <align>center</align><aligny>center</aligny>
                    <font>font12</font><textcolor>FFE0E0E0</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="236" height="60">
                <control type="image">
                    <left>0</left><top>2</top><width>224</width><height>56</height>
                    <texture border="24" colordiffuse="FF1E2329">stremiobridge-card.png</texture>
                </control>
                <control type="image">
                    <left>0</left><top>2</top><width>224</width><height>56</height>
                    <texture border="24" colordiffuse="FF12A0C7">stremiobridge-card.png</texture>
                    <visible>String.IsEqual(ListItem.Property(active),1)</visible>
                </control>
                <control type="image">
                    <left>0</left><top>2</top><width>224</width><height>56</height>
                    <texture border="24" colordiffuse="FFFFFFFF">stremiobridge-card.png</texture>
                    <visible>Control.HasFocus(60)</visible>
                </control>
                <control type="label">
                    <left>12</left><top>2</top><width>200</width><height>56</height>
                    <align>center</align><aligny>center</aligny>
                    <font>font12</font><textcolor>FF101418</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                    <visible>Control.HasFocus(60)</visible>
                </control>
                <control type="label">
                    <left>12</left><top>2</top><width>200</width><height>56</height>
                    <align>center</align><aligny>center</aligny>
                    <font>font12</font><textcolor>FFE0E0E0</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                    <visible>!Control.HasFocus(60)</visible>
                </control>
            </focusedlayout>
        </control>

        <!-- Stream cards, two columns -->
        <control type="panel" id="50">
            <left>80</left><top>306</top><width>1760</width><height>714</height>
            <orientation>vertical</orientation>
            <onup>60</onup>
            <scrolltime>200</scrolltime>
            <itemlayout width="880" height="238">
                <control type="image">
                    <left>0</left><top>0</top><width>870</width><height>222</height>
                    <texture border="24" colordiffuse="E61A1F26">stremiobridge-card.png</texture>
                </control>
                <control type="label">
                    <left>26</left><top>12</top><width>818</width><height>42</height>
                    <aligny>center</aligny><font>font13</font><textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>26</left><top>56</top><width>818</width><height>32</height>
                    <aligny>center</aligny><font>font12</font><textcolor>FFB8C0C8</textcolor>
                    <label>$INFO[ListItem.Property(line1)]</label>
                </control>
                <control type="label">
                    <left>26</left><top>88</top><width>818</width><height>32</height>
                    <aligny>center</aligny><font>font12</font><textcolor>FFB8C0C8</textcolor>
                    <label>$INFO[ListItem.Property(line2)]</label>
                </control>
                <control type="label">
                    <left>26</left><top>120</top><width>818</width><height>32</height>
                    <aligny>center</aligny><font>font12</font><textcolor>FFB8C0C8</textcolor>
                    <label>$INFO[ListItem.Property(line3)]</label>
                </control>
                <control type="image">
                    <left>26</left><top>168</top><width>818</width><height>32</height>
                    <aspectratio align="left" aligny="center">keep</aspectratio>
                    <texture>$INFO[ListItem.Art(badges)]</texture>
                </control>
            </itemlayout>
            <focusedlayout width="880" height="238">
                <control type="image">
                    <left>0</left><top>0</top><width>870</width><height>222</height>
                    <texture border="24" colordiffuse="FF12A0C7">stremiobridge-card.png</texture>
                    <visible>Control.HasFocus(50)</visible>
                </control>
                <control type="image">
                    <left>4</left><top>4</top><width>862</width><height>214</height>
                    <texture border="22" colordiffuse="FF263140">stremiobridge-card.png</texture>
                </control>
                <control type="label">
                    <left>26</left><top>12</top><width>818</width><height>42</height>
                    <aligny>center</aligny><font>font13</font><textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>26</left><top>56</top><width>818</width><height>32</height>
                    <aligny>center</aligny><font>font12</font><textcolor>FFB8C0C8</textcolor>
                    <scroll>true</scroll>
                    <label>$INFO[ListItem.Property(line1)]</label>
                </control>
                <control type="label">
                    <left>26</left><top>88</top><width>818</width><height>32</height>
                    <aligny>center</aligny><font>font12</font><textcolor>FFB8C0C8</textcolor>
                    <scroll>true</scroll>
                    <label>$INFO[ListItem.Property(line2)]</label>
                </control>
                <control type="label">
                    <left>26</left><top>120</top><width>818</width><height>32</height>
                    <aligny>center</aligny><font>font12</font><textcolor>FFB8C0C8</textcolor>
                    <scroll>true</scroll>
                    <label>$INFO[ListItem.Property(line3)]</label>
                </control>
                <control type="image">
                    <left>26</left><top>168</top><width>818</width><height>32</height>
                    <aspectratio align="left" aligny="center">keep</aspectratio>
                    <texture>$INFO[ListItem.Art(badges)]</texture>
                </control>
            </focusedlayout>
        </control>

        <!-- The focused stream's file name -->
        <control type="fadelabel">
            <left>80</left><top>1030</top><width>1760</width><height>40</height>
            <font>font12</font><textcolor>FF8A949E</textcolor>
            <scroll>true</scroll><scrollout>false</scrollout><pauseatend>3000</pauseatend>
            <label>$INFO[Container(50).ListItem.Property(filename)]</label>
        </control>
        <control type="label">
            <left>80</left><top>500</top><width>1760</width><height>60</height>
            <align>center</align><font>font13</font><textcolor>FF8A949E</textcolor>
            <label>$INFO[Window.Property(empty)]</label>
            <visible>Integer.IsEqual(Container(50).NumItems,0)</visible>
        </control>
    </controls>
</window>
