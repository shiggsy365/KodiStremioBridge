<?xml version="1.0" encoding="UTF-8"?>
<!-- View picker: view names (list 50) with a large preview of the highlighted one.
     Filled by kodi_ui/views.py. 1920x1080. -->
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <animation effect="fade" time="150">WindowOpen</animation>
    <animation effect="fade" time="150">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="E6000000">stremiobridge-white.png</texture>
        </control>
        <control type="image">
            <left>60</left><top>60</top><width>1800</width><height>960</height>
            <texture colordiffuse="FF15202B">stremiobridge-white.png</texture>
        </control>
        <control type="label">
            <left>100</left><top>80</top><width>1720</width><height>60</height>
            <font>font37</font><textcolor>FFFFFFFF</textcolor>
            <label>$INFO[Window.Property(heading)]</label>
        </control>

        <control type="list" id="50">
            <left>100</left><top>170</top><width>520</width><height>820</height>
            <orientation>vertical</orientation>
            <scrolltime>150</scrolltime>
            <itemlayout width="520" height="64">
                <control type="label">
                    <left>20</left><top>0</top><width>480</width><height>64</height>
                    <aligny>center</aligny><font>font13</font><textcolor>FFBBBBBB</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="520" height="64">
                <control type="image">
                    <left>0</left><top>2</top><width>520</width><height>60</height>
                    <texture colordiffuse="FF12A0C7">stremiobridge-white.png</texture>
                    <visible>Control.HasFocus(50)</visible>
                </control>
                <control type="label">
                    <left>20</left><top>0</top><width>480</width><height>64</height>
                    <aligny>center</aligny><font>font13</font><textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
        </control>

        <!-- Preview of the highlighted view -->
        <control type="image">
            <left>660</left><top>170</top><width>1160</width><height>653</height>
            <texture colordiffuse="FF0B1117">stremiobridge-white.png</texture>
        </control>
        <control type="image">
            <left>660</left><top>170</top><width>1160</width><height>653</height>
            <aspectratio>keep</aspectratio>
            <fadetime>150</fadetime>
            <texture background="true">$INFO[Container(50).ListItem.Art(thumb)]</texture>
        </control>
        <control type="label">
            <left>660</left><top>170</top><width>1160</width><height>653</height>
            <align>center</align><aligny>center</aligny>
            <font>font13</font><textcolor>FF888888</textcolor>
            <label>$INFO[Window.Property(no_preview)]</label>
            <visible>String.IsEmpty(Container(50).ListItem.Art(thumb))</visible>
        </control>
        <control type="label">
            <left>660</left><top>840</top><width>1160</width><height>50</height>
            <align>center</align><font>font12</font><textcolor>FFAAAAAA</textcolor>
            <label>$INFO[Container(50).ListItem.Label2]</label>
        </control>
    </controls>
</window>
